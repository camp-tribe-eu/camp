{
  "name": "camptribe",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "bootstrap:cms": "npm --prefix apps/cms run bootstrap",
    "dev:cms": "npm --prefix apps/cms run start"
  },
  "overrides": {
    "lighthouse": "^13.5.0",
    "qs": "^6.17.0",
    "lodash": "^4.18.0",
    "postcss": "^8.5.23",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "basic-ftp": "^6.2.1"
  },
  "devDependencies": {
    "js-yaml": "^5.4.1"
  }
}
