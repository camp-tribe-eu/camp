.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
# 🔴 No trailing slash. `node_modules/` matches DIRECTORIES only, so a
# node_modules SYMLINK is not ignored — and on 25.09.2026 two of them were
# committed into this public repo, pointing at absolute paths under the
# owner's home directory. Found in review, before the branch merged.
#
# A worktree gets these symlinks the moment anyone links dependencies
# instead of installing them, which is an ordinary thing to do.
node_modules
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

