# CampTribe — обмеження спроб входу по SSH (CAMP-353, пункт 6).
# Лягає в /etc/fail2ban/jail.d/zz-camptribe.local.
#
# 🔴 ІМʼЯ ПОЧИНАЄТЬСЯ З `zz` НАВМИСНО. fail2ban читає jail.d в
# алфавітному порядку, і останній прочитаний виграє. Дистрибутив кладе
# поруч `defaults-debian.conf`; файл з імʼям на «c» читався б ПЕРЕД ним,
# і наші числа тихо програли б чужим. Доводиться це не порядком у `ls`,
# а тим, що віддає `fail2ban-client get sshd maxretry` після розкладки.
#
# 🔴 ЖОДНОЇ КАМЕРИ НАД ВЕБ-СЕРВЕРОМ, І ЦЕ НЕ НЕДОГЛЯД. За Cloudflare
# адреса, яку бачить nftables, — це адреса Cloudflare. Блокування за нею
# вимкнуло б сайт для ВСІХ, а не для нападника. Якщо колись захочеться
# різати зловживання по HTTP, це робиться правилами на боці Cloudflare,
# а не тут.
#
# 🔴 БІЛИЙ СПИСОК ОПЕРАТОРА ЖИВЕ НЕ ТУТ. Репозиторій публічний, а
# домашня адреса — персональні дані, та ще й динамічна. Постійні адреси,
# якщо зʼявляться, кладуться в /etc/fail2ban/jail.d/zz-operator.local,
# якого в git немає — так само, як `gate-closed.conf` із паролем.
#
# 🔴 `bantime` ГОДИНА, А НЕ «НАЗАВЖДИ». Вічний бан плюс динамічна адреса
# — це спосіб замкнути самого себе, і запасним виходом лишиться тільки
# консоль у панелі хостера, тобто доступ власника. Година зупиняє
# перебір і відмикається сама.
#
# Вхід за паролем на машині вимкнений (`passwordauthentication no`), тож
# чесна спроба тут не падає взагалі: лічильник рухають лише чужі.

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime  = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
