# CampTribe — обмеження спроб входу по SSH (CAMP-353, пункт 6).
# Лягає в /etc/fail2ban/jail.d/zz-camptribe.local.
#
# 🔴 ЧОМУ ЦЕЙ ФАЙЛ ВИГРАЄ У `defaults-debian.conf` — І МОЄ ПЕРШЕ
# ПОЯСНЕННЯ БУЛО ХИБНЕ. Я написав «бо `zz` іде після `d` за абеткою».
# Рецензія 19.10.2026 показала інше: fail2ban читає `jail.d/*.conf`,
# ПОТІМ `jail.local`, ПОТІМ `jail.d/*.local`. Розширення `.local`
# виграє в `.conf` незалежно від імені, тож `aa-camptribe.local` теж би
# виграв. Префікс `zz` лишається лише як порядок серед інших `.local`.
#
# Висновок від цього не змінився, але правило, виведене з хибної
# причини, ламається при першій же зміні обставин — тому причина тут
# записана правильна. Доводиться це не порядком у `ls`, а тим, що
# віддає `fail2ban-client get sshd maxretry` після розкладки.
#
# 🔴 ЖОДНОЇ КАМЕРИ НАД ВЕБ-СЕРВЕРОМ, І ЦЕ НЕ НЕДОГЛЯД. За Cloudflare
# адреса, яку бачить nftables, — це адреса Cloudflare. Блокування за нею
# вимкнуло б сайт для ВСІХ, а не для нападника. Якщо колись захочеться
# різати зловживання по HTTP, це робиться правилами на боці Cloudflare,
# а не тут.
#
# 🔴 БІЛИЙ СПИСОК ОПЕРАТОРА ЖИВЕ НЕ ТУТ. Репозиторій публічний, а
# домашня адреса — персональні дані, та ще й динамічна. Постійні адреси,
# якщо зʼявляться, кладуться в /etc/fail2ban/jail.d/zz-operator.local,
# якого в git немає — так само, як `gate-closed.conf` із паролем.
#
# 🔴 `bantime` ГОДИНА, А НЕ «НАЗАВЖДИ». Вічний бан плюс динамічна адреса
# — це спосіб замкнути самого себе, і запасним виходом лишиться тільки
# консоль у панелі хостера, тобто доступ власника. Година зупиняє
# перебір і відмикається сама.
#
# 🔴 `publickey=nofail` ЗАПИСАНО ЯВНО, ХОЧ ЦЕ Й ЗАМОВЧУВАННЯ ФІЛЬТРА.
# Рецензія поставила правильне питання: вхід за паролем вимкнено
# (`passwordauthentication no`), тож рядок `Failed publickey` — це
# ЄДИНА невдача, яку оператор узагалі здатен згенерувати, а ssh-агент
# із пʼятьма ключами генерує чотири такі рядки за один вхід.
#
# Заміряно 19.10.2026: у фільтрі `sshd.conf` стоїть `publickey = nofail`
# (рядок 96), тобто такі рядки позначаються як НЕ-невдача й лічильник
# не рухають; за дві години журнал показав нуль рядків `Failed
# publickey` взагалі. Тож замкнутися не можна — але це замовчування
# ЧУЖОГО пакета, яке змінять без нас. Явний запис робить його нашим.

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1
bantime  = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
filter = sshd[publickey=nofail]
