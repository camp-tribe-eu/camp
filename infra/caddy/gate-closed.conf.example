# ЗАКРИТО (передзапуск). Приклад: на машині поруч лежить справжній
# gate-closed.conf, де замість ЗАГЛУШКИ стоїть bcrypt-хеш.
#
#   caddy hash-password --algorithm bcrypt
#   sed "s#__HASH__#<хеш>#" gate-closed.conf.example > /etc/caddy/gate-closed.conf
#   chown root:caddy /etc/caddy/gate-closed.conf && chmod 640 /etc/caddy/gate-closed.conf
#
# 🔴 640 root:caddy, А НЕ 600 root. Caddy працює від користувача `caddy` і
# файл, який може прочитати лише root, для неї не існує. 15.10.2026 саме це
# поклало сайт: `caddy validate` від root проходив, а служба падала з кодом 1
# БЕЗ жодного рядка помилки, бо вмирала раніше, ніж підіймався журнал.
# Тут раніше стояло `chmod 600` — тобто процедура сама відтворювала аварію.
#
# 🔴 ШЛЯХ ПЕРЕВІРКИ СЕРТИФІКАТА — ПОЗА ПАРОЛЕМ. Cloudflare має «Always use
# HTTPS» і переадресовує перевірку Let's Encrypt на 443 (заміряно 308);
# під паролем вона діставала б 401, і сертифікат мовчки не продовжився б
# приблизно через 60 днів.
#
# 🔴 АКАУНТИ — ТЕЖ ПОЗА ПАРОЛЕМ, І ЦЕ РІШЕННЯ ВЛАСНИКА ВІД 16.10.2026
# (CAMP-340). Браузер не може надіслати basic-auth до API: `fetch` у
# apps/web/src/lib/account.ts ходить із `credentials: 'omit'` НАВМИСНО, тож
# під паролем вся робота з акаунтом віддавала б 401. Без цього винятку
# перевірити реєстрацію, вхід і підтвердження пошти очима можна було б аж
# у день відкриття сайту — тобто саме тоді, коли дефект найдорожчий.
#
# 🔴 ВИНЯТОК ВУЗЬКИЙ НАВМИСНО: лише /api/auth/* і /api/account/*. Решта
# API (/api/spots, /api/guides) лишається під паролем, бо це база, яку
# замок і має ховати до запуску.
#
# 🔴 ЩО САМЕ ЦЕ ВІДКРИВАЄ — ПОВНИЙ ПЕРЕЛІК, А НЕ ЗРУЧНА ПОЛОВИНА. Перша
# редакція цього коментаря посилалась лише на account-rights.controller.ts
# і тому звучала безпечніше, ніж є.
#
#   /api/account/*  — безпечно: всі чотири маршрути
#                     (account-rights.controller.ts:60,69,86,123)
#                     починаються з `if (!viewer) throw
#                     new UnauthorizedException(NO_SESSION)`.
#
#   /api/auth/*     — НЕ лише вхід. Сюди входять POST /auth/signup,
#                     /auth/forgot і /auth/resend-verification. Вони
#                     шлють СПРАВЖНЮ пошту нашим SMTP на будь-яку
#                     вказану адресу, а 409 `taken` на signup дозволяє
#                     перебирати, чи існує акаунт із такою адресою.
#                     Ліміт частоти (@Throttle(MAIL)) є, пароля немає.
#
# Ціна прийнята свідомо: без цього перевірити акаунти очима можна було б
# аж у день відкриття. Домен щойно прогрітий, тож зловживання відправкою
# б'є по репутації пошти — якщо виняток стоятиме довго, його варто
# звузити до часу перевірки, а не лишати до запуску.
@needs-password not path /.well-known/acme-challenge/* /api/auth/* /api/account/*
basic_auth @needs-password {
	camptribe __HASH__
}

# 🔴 Це ДРУГИЙ замок індексації, незалежний від збірки. Заголовок, доданий
# проксі, перекриває те, що віддав Next: виставити NEXT_PUBLIC_SITE_MODE=public
# і перезібрати — НЕ досить, сайт лишиться noindex, доки стоїть цей рядок.
# Саме тому `camptribe-launch status` читає обидва замки окремо.
header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
