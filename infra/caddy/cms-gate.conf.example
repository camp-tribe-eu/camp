# ЗАМОК CMS. Приклад: на машині поруч лежить справжній cms-gate.conf, де
# замість ЗАГЛУШКИ стоїть bcrypt-хеш.
#
#   caddy hash-password --algorithm bcrypt
#   sed "s#__HASH__#<хеш>#" cms-gate.conf.example > /etc/caddy/cms-gate.conf
#   chown root:caddy /etc/caddy/cms-gate.conf && chmod 640 /etc/caddy/cms-gate.conf
#
# 🔴 640 root:caddy, А НЕ 600 root — та сама причина, що й у
# gate-closed.conf.example: 15.10.2026 файл, який міг прочитати лише
# root, поклав сайт БЕЗ жодного рядка помилки в журналі.
#
# 🔴 ЦЕ ОКРЕМИЙ ФАЙЛ ВІД `gate.conf`, І ЦЕ НАЙВАЖЛИВІШЕ ТУТ. Замок сайту
# — симлінк, який `camptribe-launch open` знімає в день запуску. Якби
# CMS імпортувала той самий `gate.conf`, відкриття сайту ВІДКРИЛО Б І
# АДМІНКУ — одним рухом, якого ніхто б не помітив, бо виглядає він як
# планова дія. Адмінка не відкривається ніколи, тож і файл у неї свій.
#
# 🔴 ПАРОЛЬ ПЕРЕД DIRECTUS БЕЗПЕЧНИЙ — ЦЕ ЗАМІРЯНО, А НЕ ПРИПУЩЕНО.
# Побоювання було конкретне: у зібраній адмінці є рядок
# `` `getToken` in this && !(`Authorization` in a.headers) `` — тобто
# застосунок уміє ставити СВІЙ заголовок Authorization, а браузер не
# додає Basic туди, де заголовок уже є. Тоді кожен виклик API після
# входу прилітав би 401, і виглядало б це як поломка Directus.
#
# 22.10.2026 я це заміряв: підняв наскрізний проксі перед локальним
# Directus, увійшов і пройшов адмінкою. З 21 РІЗНОГО виклику —
# /users/me, /permissions/me, /roles/me, /collections, /fields,
# /settings, /license, POST /auth/refresh, PATCH /users/me/track/page —
# заголовок Authorization не послав ЖОДЕН. Усі ходили з cookie сесії.
# Той рядок у бандлі лежить на гілці статичного токена, якою адмінка не
# користується. Отже Basic від браузера нічим не перекривається.
#
# 🔴 ШЛЯХ ПЕРЕВІРКИ СЕРТИФІКАТА — ПОЗА ПАРОЛЕМ, І ЦЕ НЕ ОБЕРЕЖНІСТЬ.
# Cloudflare має «Always use HTTPS» і переадресовує перевірку
# Let's Encrypt на 443 (заміряно на головному домені: 308). Під паролем
# вона дістала б 401, і сертифікат мовчки не продовжився б приблизно
# через 60 днів — тобто поломка прийшла б через два місяці після того,
# як усе «працювало».
@cms-needs-password not path /.well-known/acme-challenge/*
basic_auth @cms-needs-password {
	camptribe __HASH__
}

# 🔴 НАЗАВЖДИ, А НЕ ДО ЗАПУСКУ. Адмінка не має бути в індексі ніколи й
# за жодних обставин — на відміну від сайту, де цей заголовок знімають.
header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
