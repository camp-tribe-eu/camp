# CampTribe — публічний вхід. ЦЕЙ ФАЙЛ Є В РЕПОЗИТОРІЇ, і це навмисно
# (CAMP-322: до 15.10.2026 Caddyfile жив лише на машині, тож процедуру
# відкриття не можна було ні переглянути, ні відрепетирувати).
#
# 🔴 ПАРОЛЬ І noindex ЖИВУТЬ НЕ ТУТ, А В `gate.conf`. Це симлінк на один
# із двох файлів поруч:
#   gate-closed.conf  — basic_auth + X-Robots-Tag: noindex   (передзапуск)
#   gate-open.conf    — порожній                             (відкрито)
# Перемикає його `camptribe-launch open|close`, однією операцією, яку
# можна відкотити тією ж однією операцією. Редагувати цей файл руками
# заради відкриття НЕ ТРЕБА — саме тому замок винесено.
#
# 🔴 ХЕШ ПАРОЛЯ В РЕПОЗИТОРІЙ НЕ ПОТРАПЛЯЄ. `gate-closed.conf` збирається
# на машині з `gate-closed.conf.example`; у репозиторії лежить приклад із
# заглушкою замість хеша.

camptribe.eu, www.camptribe.eu {
	import /etc/caddy/gate.conf

	header {
		-Server
	}

	# 🔴 CAMP-340. API ЖИВЕ НА 3001 І ДО 16.10.2026 НЕ БУЛА ВИСТАВЛЕНА НІЯК.
	# Через це кожна дія з акаунтом у браузері мовчки відповідала «Accounts
	# are not available right now» — знайдено, коли власник натиснув
	# «Confirm email» у справжньому листі.
	#
	# Префікса API не має (`setGlobalPrefix` не викликається): маршрути
	# йдуть від кореня — /auth/*, /account/*, /health, /spots, /guides.
	# Тому саме `handle_path`, а не `handle`: він зрізає /api, і API дістає
	# рівно ті шляхи, які оголошує, без правок у коді.
	#
	# 🔴 ОБИДВА ПРОКСІ — В `handle`, І ЦЕ НАВМИСНО. Блоки `handle` взаємно
	# виключні й беруться в тому порядку, як написані тут. Голий
	# `reverse_proxy` поруч із `handle` працював би за порядком директив
	# Caddy, а не за порядком рядків — тобто правильно з причини, якої не
	# видно в файлі.
	#
	# 🔴 ПОКИ СТОЇТЬ ПАРОЛЬ, ЦІ ШЛЯХИ ТЕЖ ЗА ПАРОЛЕМ, і браузер їх не
	# відкриє: `fetch` у apps/web/src/lib/account.ts ходить із
	# `credentials: 'omit'` НАВМИСНО, тож basic-auth не шлеться і прилітає
	# 401. Це відомо; вивід окремих шляхів з-під пароля — рішення власника,
	# записане в CAMP-340, а не те, що можна тихо зробити тут.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	# 🔴 ЛАТКА ПРИБРАНА 12.10.2026 — виправлено причину (CAMP-294, PR #189).
	# Тут стояв `header_down Location "^https?://localhost:3000(/.*)$"`, бо
	# middleware будував ціль редиректу з `request.nextUrl.origin`, а за
	# зворотним проксі це власна адреса Next. Тепер `publicOrigin()` бере
	# `x-forwarded-host`, і Next віддає правильну абсолютну адресу.
	# Не повертай латку: якщо редиректи знову ведуть на localhost, зламався
	# код або проксі перестав передавати заголовок — лікувати треба це.
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	encode zstd gzip
}
