# CampTribe — ротація безпекового журналу Caddy (CAMP-353).
# Лягає в /etc/logrotate.d/camptribe-caddy.
#
# 🔴 ЧОМУ НЕ ВБУДОВАНОЮ РОТАЦІЄЮ CADDY. `roll_keep_for` прибирає лише ті
# файли, що ВЖЕ відротовані, а активний ротується тільки за розміром. На
# малому трафіку 10 MiB набираються місяцями, тож рядок віком 60 діб
# спокійно лежав би в активному файлі — при тому, що політика
# приватності обіцяє 14. Обіцянка, якої механізм не тримає, — це
# опублікована неправда, а не неточність.
#
# Тому в Caddyfile стоїть `roll_disabled`, і єдиний господар ротації —
# цей файл. Він рахує дні календарем, а не байтами.
#
# 🔴 `rotate 13`, А НЕ 14. Активний файл — це ще одна доба понад
# відротовані. 13 + активний = рівно 14 діб, тобто те число, що стоїть у
# політиці. З `rotate 14` найстаріший рядок жив би 15 діб.
#
# 🔴 БЕЗ `notifempty`, І ЦЕ НЕ НЕДОГЛЯД. `notifempty` пропускає ротацію,
# коли файл порожній, — а на тихій добі це означає, що активний файл не
# ротується й далі тримає вчорашні рядки. Доба тиші за добою, і строк
# знову поїхав. Порожні відротовані файли коштують байти; прострочений
# рядок коштує обіцянку.
#
# 🔴 `copytruncate`, А НЕ ПЕРЕЙМЕНУВАННЯ. Caddy тримає файл відкритим і
# не переоткриває його за сигналом; після `mv` він писав би у файл, якого
# вже немає під цим імʼям, і журнал тихо спинився б. Ціна — вікно в
# кілька мілісекунд раз на добу, коли рядок може не долетіти.
#
# 🔴 ПАРА `chattr`. Журнал лежить append-only (пункт 3 «Способу
# перевірки»): дописати можна, перезаписати, перейменувати чи видалити —
# ні. Заміряно 19.10.2026: під `+a` всі чотири заборонені операції
# справді падають з `Operation not permitted`, а Caddy пише далі (4047 →
# 5021 байт), бо відкриває файл з `O_APPEND`.
#
# Те саме `+a` забороняє й обрізання, тож атрибут знімається на час
# ротації і повертається одразу після. Якщо `postrotate` колись не
# виконається, файл лишиться без `+a` — і це видно в `lsattr`, тобто
# провал гучний, а не тихий.
/var/log/caddy/access.log {
	daily
	rotate 13
	missingok
	compress
	copytruncate
	prerotate
		/usr/bin/chattr -a /var/log/caddy/access.log 2>/dev/null || true
	endscript
	postrotate
		/usr/bin/chattr +a /var/log/caddy/access.log 2>/dev/null || true
	endscript
}
