#!/bin/bash
# CAMP-306: лишити слід від падіння там, де його знайдуть без journal.
#
# 🔴 ФАЙЛ, А НЕ ЛИСТ. Каналу назовні в машини поки немає (пошта — CAMP-110),
# і вигадувати його тут означало б або класти секрет на сервер, або
# публікувати стан інфраструктури. Файл переживає перезавантаження, його
# читає `scripts/ci/check-server-drift.mjs` по SSH, і він зникає сам,
# коли те, що впало, відпрацює успішно.
set -euo pipefail
UNIT="${1:?який юніт впав}"
DIR=/srv/camptribe/failed
mkdir -p "$DIR"
# 🔴 Цей юніт біжить від root, а знімає слід — `camptribe-backup` від
# користувача `camptribe`. Без цього рядка `rm -f` у бекапі впав би на
# правах і перетворив УСПІШНИЙ прогін на провальний, тобто сторож
# ламав би саме те, що стереже.
chown -R camptribe:camptribe "$DIR" 2>/dev/null || true
printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$DIR/$UNIT"
# У journal теж, бо той, хто вже дивиться в journal, мусить це побачити.
echo "camptribe: $UNIT впав, слід у $DIR/$UNIT" >&2
