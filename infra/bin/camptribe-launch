#!/usr/bin/env bash
# CampTribe — ВИМИКАЧ ВІДКРИТТЯ: зняти пароль і пустити пошукові системи
# (CAMP-322). Виконується НА СЕРВЕРІ.
#
#   camptribe-launch status                  # лише читає; друкує всі замки
#   camptribe-launch env --public [--apply]  # 1-й замок: рядок у .env
#   camptribe-launch open  [--apply]         # 3-й замок: Caddy
#   camptribe-launch close [--apply]         # назад під пароль
#
# Зазвичай запускається не напряму, а з ноутбука: `infra/launch-switch.sh`.
#
# 🔴 ЗАМКІВ ТРИ, А НЕ ОДИН. Картка CAMP-322 казала «вмикається однією
# змінною» — це було неправдою, і саме через це процедура потрібна:
#
#   1. `.env`  NEXT_PUBLIC_SITE_MODE=public    — читається НА ЗБІРЦІ
#   2. збірка  robots.txt + X-Robots-Tag       — те, що насправді віддає Next
#   3. Caddy   basic_auth + X-Robots-Tag       — ПЕРЕКРИВАЄ те, що віддав Next
#
# Виставити змінну й перезапустити службу — НЕ відкриває сайт: значення
# запікається на збірці (`apps/web/next.config.mjs:22`), тож між 1 і 3
# обовʼязково стоїть повна викладка. А зняти пароль, не зробивши 1 і 2,
# означає пустити робота на сторінки, які самі себе просять не індексувати:
# `robots.txt` із `Disallow: /`. Обидві половини однаково марні.
#
# 🔴 СУХИЙ ПРОГІН ЗА ЗАМОВЧУВАННЯМ. Усе, що міняє машину, вимагає --apply.
#
# 🔴 ПЕРЕВІРКА — ТІЛЬКИ ЗЗОВНІ. Запитувати 127.0.0.1:3000 після відкриття
# безглуздо: Caddy там і не стоїть, а саме він додає noindex. Перевірка,
# яка не проходить через проксі, зеленіла б при повністю закритому сайті.
#
# Коди виходу:
#   0  зроблено (або сухий прогін показав план); для status — замки згодні
#   1  зупинка ДО зміни: передумова не виконана; для status — замки РОЗІЙШЛИСЬ
#   2  неправильний виклик
#   3  змінили, перевірка ззовні не пройшла, стан ПОВЕРНУТО й перевірено
#   4  змінили, перевірка не пройшла, повернути не вдалось: стан невідомий
set -euo pipefail

ROOT="${CAMPTRIBE_ROOT:-/srv/camptribe}"
LINK="${CAMPTRIBE_LINK:-current}"
CADDY_DIR="${CAMPTRIBE_CADDY_DIR:-/etc/caddy}"
CADDY_BIN="${CAMPTRIBE_CADDY_BIN:-caddy}"
CADDYFILE="${CAMPTRIBE_CADDYFILE:-$CADDY_DIR/Caddyfile}"
GATE="${CAMPTRIBE_GATE:-$CADDY_DIR/gate.conf}"
GATE_OPEN="${CAMPTRIBE_GATE_OPEN:-$CADDY_DIR/gate-open.conf}"
GATE_CLOSED="${CAMPTRIBE_GATE_CLOSED:-$CADDY_DIR/gate-closed.conf}"
WEB_URL="${CAMPTRIBE_WEB_URL:-http://127.0.0.1:3000}"
SITE_URL="${CAMPTRIBE_SITE_URL:-https://camptribe.eu}"
CURL="${CAMPTRIBE_CURL:-curl}"
CADDY_USER="${CAMPTRIBE_CADDY_USER:-caddy}"
SUDO="${CAMPTRIBE_SUDO:-sudo}"
VERIFY_TRIES="${CAMPTRIBE_VERIFY_TRIES:-10}"
VERIFY_SLEEP="${CAMPTRIBE_VERIFY_SLEEP:-3}"

say()  { printf '%s\n' "$*"; }
warn() { printf '  ⚠ %s\n' "$*" >&2; }
die()  { printf '✗ %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,30p' "${BASH_SOURCE[0]:-$0}" | sed 's/^# \{0,1\}//'; exit 2; }

rel_dir() { readlink -f "$ROOT/$LINK"; }
envfile() { printf '%s/apps/api/.env\n' "$(rel_dir)"; }

# --- читання замків -------------------------------------------------------
# Кожен замок читається З ТОГО МІСЦЯ, ЯКЕ НА НЬОГО ВПЛИВАЄ, і жоден — з
# іншого замка. Інакше три перевірки перетворюються на одну, повторену тричі.

# 1. Рядок у .env. Саме рядок, не процес: служба могла стартувати раніше.
lock_env() {
  local f; f="$(envfile)"
  [ -f "$f" ] || { echo 'немає'; return; }
  if grep -Eq '^[[:space:]]*NEXT_PUBLIC_SITE_MODE[[:space:]]*=[[:space:]]*public[[:space:]]*$' "$f"
  then echo 'public'; else echo 'closed'; fi
}

# 2. Те, що ВІДДАЄ зібраний Next. Не `.next/`-тека й не дата збірки:
# тека існує й після dev-сервера, а відповідь буває лише від збірки.
lock_build() {
  local body hdr
  body="$($CURL -fsS --max-time 10 "$WEB_URL/robots.txt" 2>/dev/null || true)"
  [ -n "$body" ] || { echo 'невідомо'; return; }
  hdr="$($CURL -fsS --max-time 10 -o /dev/null -D - "$WEB_URL/robots.txt" 2>/dev/null || true)"
  if printf '%s' "$body" | grep -Eq '^[[:space:]]*Disallow:[[:space:]]*/[[:space:]]*$' \
     || printf '%s' "$hdr" | grep -qi 'x-robots-tag:.*noindex'
  then echo 'closed'; else echo 'public'; fi
}

# 3. На що показує gate.conf. Читаємо ЦІЛЬ симлінка, а не вміст: порожній
# файл і симлінк на порожній файл — різні стани, і відкочуються по-різному.
lock_gate() {
  [ -L "$GATE" ] || { echo 'не-симлінк'; return; }
  case "$(readlink -f "$GATE")" in
    "$(readlink -f "$GATE_OPEN")")   echo 'open' ;;
    "$(readlink -f "$GATE_CLOSED")") echo 'closed' ;;
    *) echo 'чуже' ;;
  esac
}

# 4. Що бачить сторонній. Єдине, що має значення для пошуковика; решта
# три — лише пояснення, ЧОМУ він бачить саме це.
lock_public() {
  local bust code hdr body
  bust="$(date +%s)-$$"
  code="$($CURL -s --max-time 20 -o /dev/null -w '%{http_code}' "$SITE_URL/?nocache=$bust" 2>/dev/null || echo 000)"
  [ "$code" = 000 ] && { echo 'недосяжно'; return; }
  [ "$code" = 401 ] && { echo 'пароль'; return; }
  # 🔴 «НЕ 401» НЕ ОЗНАЧАЄ «ВІДКРИТО». Перша редакція вважала відкритим усе,
  # що не 401 і не 000: 503 від CDN, сторінка-челендж WAF, 403 — усе це
  # читалось як успіх, і `open --apply` виходив нулем над сайтом, який
  # насправді лежить. Відкрито — це саме 200 і нічого іншого.
  [ "$code" = 200 ] || { echo "код-$code"; return; }
  hdr="$($CURL -s --max-time 20 -o /dev/null -D - "$SITE_URL/?nocache=$bust" 2>/dev/null || true)"
  printf '%s' "$hdr" | grep -qi 'x-robots-tag:.*noindex' && { echo 'noindex'; return; }
  body="$($CURL -s --max-time 20 "$SITE_URL/robots.txt?nocache=$bust" 2>/dev/null || true)"
  printf '%s' "$body" | grep -Eq '^[[:space:]]*Disallow:[[:space:]]*/[[:space:]]*$' && { echo 'robots-disallow'; return; }
  echo 'відкрито'
}

status() {
  local e b g p seen_files=""
  e="$(lock_env)"; b="$(lock_build)"; g="$(lock_gate)"; p="$(lock_public)"
  say "1. .env   NEXT_PUBLIC_SITE_MODE : $e      ($(envfile))"
  say "2. збірка віддає robots/X-Robots: $b      ($WEB_URL)"
  say "3. Caddy  gate.conf              : $g      ($GATE)"
  say "4. ззовні                        : $p      ($SITE_URL)"

  # 🔴 CAMP-339: ПʼЯТИЙ рядок, і він єдиний ловить саму аварію 15–16.10.2026.
  # Її не було видно жодному з чотирьох вище: права на gate-closed.conf
  # виставили о 14:50, перемикання НЕ відбувалось, усі замки показували
  # правильне, сайт працював — бо Caddy тримав уже прочитану копію в
  # памʼяті. Лягло воно через добу, на першому перезапуску.
  # Сторож, який питає лише під час перемикання, цього випадку не бачить:
  # перемикання тут не було взагалі.
  # 🔴 ВІДСУТНІЙ ФАЙЛ — ЦЕ ПОМИЛКА, А НЕ ПРОПУСК. Перша редакція мала тут
  # `[ -f "$f" ] || continue`, і тоді рядок ставав підписом: при
  # видаленому `gate-closed.conf` він друкував «обидва файли читає caddy»
  # і виходив 0 — про файл, якого немає. А він і справді може бути
  # відсутнім: його збирають на машині з `.example`, у репозиторії його
  # нема. «Немає» і «читається» — це не одне й те саме твердження.
  # 🔴 І ТРЕТІЙ ФАЙЛ — ТОЙ, НА ЯКИЙ gate.conf ВКАЗУЄ НАСПРАВДІ. Перша
  # редакція ходила тільки по двох відомих іменах, тож при gate.conf,
  # наведеному на щось стороннє, рядок друкував «обидва читає caddy», а
  # Caddy імпортував саме той третій, нечитабельний. Що такий стан буває,
  # знає й решта коду: `lock_gate` має для нього окремий вердикт «чуже».
  local f bad=0 live
  live="$(readlink -f "$GATE" 2>/dev/null || true)"
  for f in "$GATE_OPEN" "$GATE_CLOSED" "$live"; do
    [ -n "$f" ] || continue
    case " $seen_files " in *" $f "*) continue ;; esac
    seen_files="${seen_files-} $f"
    if [ ! -e "$f" ]; then
      bad=1; say "5. права  🔴 НЕМАЄ $f"
    elif ! readable_by_caddy "$f"; then
      bad=1; say "5. права  🔴 «$CADDY_USER» НЕ ЧИТАЄ $f"
    fi
  done
  [ "$bad" = 0 ] && say "5. права  обидва файли замка читає «$CADDY_USER»"
  say ''
  if [ "$bad" != 0 ]; then
    say '🔴 ЗАМОК ОДНОРАЗОВИЙ. Поки це так, перемикання вдасться, а Caddy не'
    say '   підніметься при наступному перезапуску — і причина буде за добу'
    say '   від дії. Полагодь обидва:'
    say "     chown root:$CADDY_USER <файл> && chmod 640 <файл>"
    return 1
  fi
  if [ "$e" = closed ] && [ "$b" = closed ] && [ "$g" = closed ] && [ "$p" = 'пароль' ]; then
    say 'ЗАКРИТО — всі три замки на місці, ззовні пароль.'; return 0
  fi
  if [ "$e" = public ] && [ "$b" = public ] && [ "$g" = open ] && [ "$p" = 'відкрито' ]; then
    say 'ВІДКРИТО — жодного замка, ззовні сторінка без noindex.'; return 0
  fi
  say '🔴 НЕУЗГОДЖЕНО. Наступний крок:'
  [ "$e" != public ] && { say '   camptribe-launch env --public --apply'; return 1; }
  [ "$b" != public ] && { say '   повна викладка (infra/deploy-app.sh --apply): змінна запікається на збірці'; return 1; }
  [ "$g" != open ]   && { say '   camptribe-launch open --apply'; return 1; }
  say "   замки зняті, а ззовні «$p» — дивись кеш Cloudflare (Purge Everything) і docs/launch-switch.md"
  return 1
}

# --- зміни ----------------------------------------------------------------
set_env() { # public|closed
  local want="$1" f cur
  f="$(envfile)"; cur="$(lock_env)"
  [ -f "$f" ] || die "немає $f"
  if [ "$cur" = "$want" ]; then say "  .env уже «$want» — нічого не міняю"; return 0; fi
  if [ "$APPLY" != 1 ]; then say "  [сухий] .env: $cur → $want ($f)"; return 0; fi
  cp -p "$f" "$f.bak.$(date +%Y%m%d-%H%M%S)"
  local tmp; tmp="$(mktemp)"
  grep -Ev '^[[:space:]]*NEXT_PUBLIC_SITE_MODE[[:space:]]*=' "$f" > "$tmp"
  [ "$want" = public ] && printf 'NEXT_PUBLIC_SITE_MODE=public\n' >> "$tmp"
  ( umask 077; cat "$tmp" > "$f" ); rm -f "$tmp"
  [ "$(lock_env)" = "$want" ] || die "записав, а читається «$(lock_env)» — не чіпай машину далі"
  say "  ✓ .env: $cur → $want"
  say '  🔴 САМО ПО СОБІ ЦЕ НІЧОГО НЕ ЗМІНИЛО: значення читається на збірці.'
  say '     Далі — повна викладка, інакше замок 2 лишиться закритим.'
}

# 🔴 ПОВЕРТАЄ СИМЛІНК САМА. Симлінк уже переставлено, коли викликають це:
# вийти тут із `die`, як було в першій редакції, означало б лишити
# gate.conf на новій цілі, а в повідомленні написати «повернуто».
caddy_apply() { # «що робимо» для повідомлення, куди вертати
  local what="$1" back="$2"
  if ! "$CADDY_BIN" validate --config "$CADDYFILE" >/dev/null 2>&1; then
    point_gate "$back"
    die "caddy validate не пройшов ($what): gate.conf повернуто на $back, Caddy не перечитував"
  fi
  if ! "$CADDY_BIN" reload --config "$CADDYFILE" >/dev/null 2>&1; then
    point_gate "$back"
    # Якщо й це не перечиталось, Caddy лишився на тому, що мав: симлінк
    # повернуто, але чинною є попередня конфігурація. Кажемо саме так.
    "$CADDY_BIN" reload --config "$CADDYFILE" >/dev/null 2>&1 \
      || die "caddy reload не вдався ($what) і повторний теж: gate.conf повернуто на $back, але Caddy досі на попередній конфігурації"
    die "caddy reload не вдався ($what): gate.conf повернуто на $back"
  fi
}

# `ln -sfn` і не `mv -T`: -T є лише в GNU coreutils, а самоперевірка
# ганяється і на macOS. Ціль завжди файл, тож -n досить.
point_gate() { ln -sfn "$1" "$GATE"; }

# CAMP-339: чи може ПРОЧИТАТИ цей файл користувач, від якого працює Caddy.
#
# 🔴 НЕ «чи існує» і не «які там права». Саме читання тим користувачем —
# бо все інше бреше одразу в три боки:
#   * `[ -f ]` від root бачить файл, якого служба не бачить;
#   * `caddy validate` теж виконується від root і каже «Valid configuration»;
#   * `caddy reload` віддає вже РОЗІБРАНИЙ конфіг в admin API, тож робочий
#     процес файла не торкається — перемикання «вдається», а сайт лягає
#     при наступному перезапуску, через добу й без видимої причини.
# Саме так воно й сталось 15–16.10.2026: права виставили о 14:50, а впало
# на перезапуску наступного дня.
# 🔴 ПІДМІНЮЄТЬСЯ `sudo`, А НЕ ЦЯ ФУНКЦІЯ. Перша редакція мала окрему
# змінну READCHECK, і самотест задавав її ЗАВЖДИ — тобто рядок, який
# справді поїде на машину, не виконувався в наборі жодного разу. Мутація
# «прибрати `sudo -u $CADDY_USER`» лишала всі випадки зеленими, хоч на
# сервері скрипт іде від root, root читає все, і перевірка ставала
# порожньою. Тепер підміняється зовнішня команда, а тіло функції —
# те саме і в тесті, і в проді.
readable_by_caddy() { # файл
  "$SUDO" -u "$CADDY_USER" test -r "$1"
}

switch_gate() { # open|closed
  local want="$1" target cur expect
  cur="$(lock_gate)"
  [ "$want" = open ] && target="$GATE_OPEN" || target="$GATE_CLOSED"
  [ -f "$target" ] || die "немає $target"
  [ "$want" = open ] && expect='відкрито' || expect='пароль'

  # 🔴 ПЕРЕВІРКИ СТОЯТЬ ДО «вже в цьому стані». Перша редакція ставила їх
  # нижче, і `close --apply` на вже закритому сайті віддавав 0 без жодної
  # скарги — навіть коли файл, який Caddy імпортує ПРЯМО ЗАРАЗ, він
  # прочитати не може. Це дослівно форма аварії 15–16.10: перемикання
  # немає, усе зелене, лягає на перезапуску. Тільки гірше: оператор тисне
  # аварійний важіль, бачить 0 і йде спати.
  # 🔴 CAMP-339. Тут легко помилитись у ОБИДВА боки, і я помилився в обидва.
  #
  # ЖОРСТКО НА ЦІЛІ — її Caddy читатиме після перемикання.
  readable_by_caddy "$target" || die "користувач «$CADDY_USER» НЕ МОЖЕ прочитати $target — Caddy не підніметься при наступному перезапуску, хоч reload і validate цього не покажуть. Полагодь і повтори:
     chown root:$CADDY_USER $target && chmod 640 $target"

  # 🔴 І ЖОРСТКО НА gate-closed.conf, НАВІТЬ КОЛИ ЦІЛЬ ІНША. Відкат у цьому
  # самому прогоні йде саме туди — `caddy_apply … "$GATE_CLOSED"` і
  # `point_gate "$GATE_CLOSED"` нижче вказують на нього незалежно від
  # напрямку. Якщо він нечитабельний, невдале відкриття поверне gate.conf
  # на файл, якого служба не прочитає, і скрипт назве це «повернуто під
  # пароль, і це перевірено». Попередження тут замало: це не «колись
  # знадобиться», це ціль відкату ЦЬОГО запуску.
  if [ "$target" != "$GATE_CLOSED" ]; then
    [ -e "$GATE_CLOSED" ] || die "немає $GATE_CLOSED — а саме туди цей запуск відкотиться, якщо перевірка ззовні не пройде. Зібери його з $GATE_CLOSED.example за docs/launch-switch.md і повтори"
    readable_by_caddy "$GATE_CLOSED" || die "користувач «$CADDY_USER» НЕ МОЖЕ прочитати $GATE_CLOSED — а саме туди цей запуск відкотиться, якщо перевірка ззовні не пройде. Відкрити зараз означає лишити машину без робочого шляху назад. Полагодь і повтори:
     chown root:$CADDY_USER $GATE_CLOSED && chmod 640 $GATE_CLOSED"
  fi

  # А файл, який НЕ є ні ціллю, ні ціллю відкату — лише попередження.
  # Валити через нього означало б заглушити аварійний важіль: `close` не
  # пішов би через права на gate-open.conf, якого Caddy після закриття
  # взагалі не читає.
  local other gate_warn=0
  [ "$want" = open ] && other="$GATE_CLOSED" || other="$GATE_OPEN"
  if [ "$other" != "$GATE_CLOSED" ]; then
    if [ ! -e "$other" ]; then
      gate_warn=1; say "  ⚠ немає $other — ШЛЯХУ НАЗАД НЕ ІСНУЄ"
    elif ! readable_by_caddy "$other"; then
      gate_warn=1
      say "  ⚠ «$CADDY_USER» не читає $other — назад перемкнути вдасться, але Caddy впаде на наступному перезапуску:"
      say "     chown root:$CADDY_USER $other && chmod 640 $other"
    fi
  fi

  if [ "$cur" = "$want" ]; then say "  gate.conf уже «$want» — нічого не міняю"; return 0; fi

  if [ "$want" = open ]; then
    local b; b="$(lock_build)"
    [ "$b" = public ] || die "збірка віддає «$b»: зняти пароль зараз означає пустити робота на сайт, який сам просить себе не індексувати. Спершу env --public і повна викладка"
  fi

  if [ "$APPLY" != 1 ]; then
    say "  [сухий] gate.conf: $cur → $want ($target)"
    say "  [сухий] далі: caddy validate && caddy reload, тоді перевірка ззовні ($SITE_URL)"
    # 🔴 Не друкуємо «читає обидва», якщо щойно попередили про протилежне:
    # перша редакція казала обидві речі через два рядки одна від одної.
    [ "$gate_warn" = 0 ] && say "  [сухий] права: «$CADDY_USER» читає обидва файли замка"
    return 0
  fi

  # 🔴 `readlink -f` НА ЗВИЧАЙНОМУ ФАЙЛІ ВІДДАЄ ЙОГО Ж ШЛЯХ. Перша редакція
  # перевіряла `[ -n "$was" ]` і тому пропускала рукописний gate.conf далі:
  # `ln -sfn gate.conf gate.conf` знищував файл і робив симлінк на себе
  # (ELOOP), а полагодити це `close` вже не міг. Питаємо саме про симлінк.
  [ -L "$GATE" ] || die "gate.conf — не симлінк, а звичайний файл. Я його не чіпаю: зроби симлінк на gate-closed.conf за docs/launch-switch.md"
  point_gate "$target"
  caddy_apply "$cur → $want" "$GATE_CLOSED"
  say "  ✓ gate.conf: $cur → $want, Caddy перечитано"

  local seen=""
  for _ in $(seq 1 "$VERIFY_TRIES"); do
    seen="$(lock_public)"
    [ "$seen" = "$expect" ] && { say "  ✓ ззовні: $seen"; return 0; }
    sleep "$VERIFY_SLEEP"
  done

  # 🔴 ВІДКОЧУЄМОСЬ ЗАВЖДИ ПІД ПАРОЛЬ, А НЕ «ТУДИ, ДЕ БУЛИ». Перша редакція
  # вертала на попередню ціль — і для `close` попередньою ціллю був
  # ВІДКРИТИЙ gate. Тобто команда, чия єдина робота повернути пароль,
  # при недосяжній публічній адресі лишала сайт відкритим і друкувала
  # «стан повернуто й перевірено». Безпечний стан тут один, і він не
  # залежить від напрямку.
  warn "ззовні «$seen», чекали «$expect» — повертаю під пароль"
  point_gate "$GATE_CLOSED"
  if "$CADDY_BIN" validate --config "$CADDYFILE" >/dev/null 2>&1 \
     && "$CADDY_BIN" reload --config "$CADDYFILE" >/dev/null 2>&1 \
     && [ "$(lock_gate)" = closed ]; then
    printf '✗ перевірка не пройшла, сайт повернуто під пароль і це перевірено\n' >&2; exit 3
  fi
  printf '✗ перевірка не пройшла, і повернути під пароль перевіреним не вийшло — дивись %s\n' "$GATE" >&2; exit 4
}

# --- розбір ---------------------------------------------------------------
[ $# -ge 1 ] || usage
CMD="$1"; shift
APPLY=0; WANT=''
while [ $# -gt 0 ]; do
  case "$1" in
    --apply)  APPLY=1 ;;
    --public) WANT=public ;;
    --closed) WANT=closed ;;
    -h|--help) usage ;;
    *) printf 'невідомий прапорець: %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done
if [ "$APPLY" != 1 ] && [ "$CMD" != status ]; then
  say 'СУХИЙ ПРОГІН — нічого не змінено. Додай --apply.'
fi

case "$CMD" in
  status) status ;;
  env)    [ -n "$WANT" ] || { echo 'env вимагає --public або --closed' >&2; exit 2; }; set_env "$WANT" ;;
  open)   switch_gate open ;;
  close)  switch_gate closed ;;
  *) usage ;;
esac
