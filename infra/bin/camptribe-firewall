#!/usr/bin/env bash
# CampTribe — origin приймає зʼєднання ЛИШЕ від Cloudflare (CAMP-337).
# Виконується НА СЕРВЕРІ.
#
#   camptribe-firewall status           # лише читає; друкує розбіжності
#   camptribe-firewall sync [--apply]   # привести ufw до опублікованих діапазонів
#
# 🔴 НАВІЩО. Заміряно 16.10 і підтверджено 17.10.2026: запит із
# підстановкою адреси повз Cloudflare доходить до origin і дістає
# відповідь Caddy. Сьогодні обидва шляхи впираються в передзапусковий
# пароль, тож обхід нічого не дає. У день відкриття пароль знімуть — і
# все, заради чого тримають Cloudflare (WAF, обмеження частоти, захист
# від ботів, поглинання обсягу), стане для нападника НЕОБОВʼЯЗКОВИМ.
# Дефект уже є; його наслідок зʼявиться рівно в день запуску.
#
# 🔴 СЕРТИФІКАТ ЦИМ НЕ ЛАМАЄТЬСЯ, і це доведено, а не припущено. У
# журналі Caddy за 12.10.2026: `tls-alpn-01` ПАДАЄ з «Cannot negotiate
# ALPN protocol acme-tls/1» — тобто TLS термінує хтось посередині, —
# а наступним рядком проходить `http-01`. Отже перевірка Let's Encrypt
# уже сьогодні йде ЧЕРЕЗ Cloudflare, а не повз нього, і обмеження
# діапазонами її не зачіпає.
#
# ⚠️ Ціна, яку треба знати: після обмеження не можна тимчасово знімати
# проксі Cloudflare (сіра хмарка) — поновлення сертифіката зламається
# саме тоді, а побачимо ми це через вісім тижнів.
#
# 🔴 ЧОГО ЦЕЙ СКРИПТ НЕ РОБИТЬ: не чіпає SSH і взагалі жодного порту,
# крім 80 і 443. Правило SSH він не створює, не видаляє і не переписує;
# якщо дозволу на SSH у поточному стані НЕМА, скрипт зупиняється до
# будь-якої зміни — такий стан означає, що машина налаштована не так,
# як він думає, і наосліп її замикати не можна.
#
# 🔴 ДОДАЄМО ПЕРЕД ТИМ, ЯК ВИДАЛЯТИ. Якщо спершу зняти загальний дозвіл,
# а потім впасти, сайт лишиться недосяжним і для Cloudflare. Порядок
# зворотний: спершу всі дозволи діапазонам, і лише потім зняття
# загального. Між цими кроками сайт доступний обома шляхами — зайве
# вікно відкритості коротше за вікно недоступності.
#
# Коди виходу:
#   0  зроблено (або сухий прогін показав план); для status — усе збігається
#   1  зупинка ДО зміни; для status — є розбіжність
#   2  неправильний виклик
set -euo pipefail

UFW="${CAMPTRIBE_UFW_BIN:-ufw}"
CURL="${CAMPTRIBE_CURL_BIN:-curl}"
V4_URL="${CAMPTRIBE_CF_V4_URL:-https://www.cloudflare.com/ips-v4}"
V6_URL="${CAMPTRIBE_CF_V6_URL:-https://www.cloudflare.com/ips-v6}"
SSH_PORT="${CAMPTRIBE_SSH_PORT:-22}"
PORTS="${CAMPTRIBE_PORTS:-80,443}"

# 🔴 ПІДЛОГИ, А НЕ «СКІЛЬКИ ПРИЙШЛО». Порожня відповідь, сторінка
# помилки або обрізаний список — це ВІДМОВА, а не «застосувати нуль
# правил». Нуль правил тут означає закритий для всіх сайт. Cloudflare
# роками публікує 15 діапазонів IPv4 і 7 IPv6; підлоги взяті нижче з
# запасом, щоб скрипт пережив звичайну зміну списку, але не пережив
# його зникнення.
# Справжні числа, зміряні 19.10.2026: 15 діапазонів IPv4 і 7 IPv6.
# Підлоги 10/4 дозволяли мовчки втратити третину списку — рецензія
# назвала це числом: 33% v4 і 43% v6. 12/6 лишає запас на звичайну
# зміну (мінус три мережі v4, мінус одна v6) і не пускає обвал.
MIN_V4="${CAMPTRIBE_MIN_V4:-12}"
MIN_V6="${CAMPTRIBE_MIN_V6:-6}"

die() { echo "$*" >&2; exit 1; }
usage() { echo "camptribe-firewall status | sync [--apply]" >&2; exit 2; }

CMD="${1:-}"; shift || true
APPLY=0
for a in "$@"; do
  case "$a" in
    --apply) APPLY=1 ;;
    *) usage ;;
  esac
done
case "$CMD" in status|sync) ;; *) usage ;; esac

# ── опубліковані діапазони ────────────────────────────────────────────
#
# 🔴 Перевіряємо ФОРМУ кожного рядка, а не лише кількість. Сторінка
# помилки Cloudflare — теж текст, і теж має рядки. Форма перевіряється
# ОКРЕМО для v4 і v6: рецензія показала, що набір бачив лише перевірку
# v4, і мутація «форма IPv6 → будь-що» лишала всі випадки зеленими,
# після чого 502-сторінка їхала в `ufw allow from "<h1>502 Bad…"`.
#
# 🔴 СТАТУС ПЕРЕВІРЯЄТЬСЯ ЯВНО, А НЕ ЧЕРЕЗ `set -e`. У bash 3.2 (macOS)
# `exit` усередині `$( )` НЕ зупиняє зовнішній скрипт на присвоєнні, у
# bash ≥ 4.1 (Ubuntu, CI) — зупиняє. Тобто той самий набір давав різний
# вердикт на ноутбуці й на раннері, і ніде це не було сказано. Тому
# кожен шлях відмови тут — явна перевірка коду, а не надія на прапорець.
fetch_list() {
  local url="$1" want="$2" out line
  out="$("$CURL" -fsSL --max-time 20 --retry 2 "$url")" || return 3
  while IFS= read -r line; do
    line="${line%%$'\r'}"
    line="${line#"${line%%[![:space:]]*}"}"
    [ -n "$line" ] || continue
    case "$want" in
      v4) [[ "$line" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] || return 4 ;;
      v6) [[ "$line" =~ ^[0-9a-fA-F]{0,4}(:[0-9a-fA-F]{0,4})+/[0-9]{1,3}$ ]] || return 4 ;;
    esac
    echo "$line"
  done <<<"$out"
}

# 🔴 ЛІЧИМО ПІСЛЯ ДЕДУПЛІКАЦІЇ, І ЦЕ БУВ ДЕФЕКТ. Підлога міряла сирі
# рядки, а застосовувався `sort -u`. Список із 12 однакових мереж плюс
# одна проходив «13 ≥ 10», друкував «опубліковано: 3», ставив три
# правила, знімав загальні дозволи й виходив НУЛЕМ — 12 із 15 справжніх
# мереж Cloudflare відрізано, і жодного червоного. Підлога мусить міряти
# той самий корпус, що й дія.
published() {
  local v4 v6 n4 n6 rc
  v4="$(fetch_list "$V4_URL" v4)"; rc=$?
  [ "$rc" = 0 ] || die "$V4_URL: $([ "$rc" = 3 ] && echo 'не вдалось прочитати' || echo 'рядок не схожий на мережу IPv4') — нічого не міняю"
  v6="$(fetch_list "$V6_URL" v6)"; rc=$?
  [ "$rc" = 0 ] || die "$V6_URL: $([ "$rc" = 3 ] && echo 'не вдалось прочитати' || echo 'рядок не схожий на мережу IPv6') — нічого не міняю"
  v4="$(sort -u <<<"$v4")"; v6="$(sort -u <<<"$v6")"
  n4="$(grep -c . <<<"$v4" || true)"; n6="$(grep -c . <<<"$v6" || true)"
  [ "$n4" -ge "$MIN_V4" ] \
    || die "Cloudflare віддав $n4 РІЗНИХ діапазонів IPv4 (чекали щонайменше $MIN_V4) — нічого не міняю"
  [ "$n6" -ge "$MIN_V6" ] \
    || die "Cloudflare віддав $n6 РІЗНИХ діапазонів IPv6 (чекали щонайменше $MIN_V6) — нічого не міняю"
  printf '%s\n%s\n' "$v4" "$v6" | sort -u
}

ufw_status() { "$UFW" status numbered 2>/dev/null || die "не вдалось прочитати стан ufw"; }

# ── розбір виводу ufw ─────────────────────────────────────────────────
#
# 🔴 ПО КОЛОНКАХ, А НЕ ГРЕПОМ ПО РЯДКУ. Перша версія шукала « ALLOW IN »
# будь-де в рядку — і казала «SSH дозволено» на
#   22/tcp   DENY IN   Anywhere   # ALLOW IN only via VPN
# тобто готова була замкнути машину, прочитавши чийсь коментар. Тут
# коментар зрізається першим, а дія читається як КОЛОНКА.
#
# Формат `ufw status numbered`: "[ن] <To>  <ACTION IN|OUT|FWD>  <From>".
# `To` може містити пробіли (`80/tcp (v6)`, `Nginx Full`), тож ріжемо по
# самій дії, а не по пробілах.
ufw_rows() {
  sed -E 's/^\[[ 0-9]+\][[:space:]]*//; s/[[:space:]]*#.*$//' <<<"$1" \
    | awk '
        match($0, / (ALLOW|DENY|REJECT|LIMIT) (IN|OUT|FWD) /) {
          to = substr($0, 1, RSTART - 1)
          act = substr($0, RSTART + 1, RLENGTH - 2)
          from = substr($0, RSTART + RLENGTH)
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", to)
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", from)
          sub(/ \(v6\)$/, "", to)
          print to "\t" act "\t" from
        }'
}

is_anywhere() { case "$1" in Anywhere|"Anywhere (v6)") return 0 ;; *) return 1 ;; esac; }

# Чи відкриває цей `To` котрийсь із наших портів усім.
#
# 🔴 НЕРОЗПІЗНАНА ФОРМА — ЦЕ ПОМИЛКА, А НЕ ТИША. `ufw allow 80` друкує
# просто `80`; `ufw allow 'Nginx Full'` — назву профілю; бувають
# `80:443/tcp` і `LIMIT IN`. Перша версія шукала `^(80|443)/tcp` і над
# станом із `Nginx Full ALLOW IN Anywhere` друкувала «origin приймає
# лише Cloudflare» з кодом 0. Те, чого скрипт не вміє прочитати, він
# мусить НАЗВАТИ, а не промовчати.
opens_our_ports() {
  local to="$1" p ports base
  base="${to%%/*}"
  case "$to" in
    *[0-9]/tcp|*[0-9]) ;;
    *) return 2 ;;   # не число і не число/tcp — не беруся судити
  esac
  case "$base" in
    *[!0-9,:]*) return 2 ;;
  esac
  for p in ${PORTS//,/ }; do
    case "$base" in
      "$p") return 0 ;;
      *,*) IFS=, read -ra ports <<<"$base"
           for q in "${ports[@]}"; do [ "$q" = "$p" ] && return 0; done ;;
      *:*) [ "$p" -ge "${base%%:*}" ] && [ "$p" -le "${base##*:}" ] && return 0 ;;
    esac
  done
  return 1
}

# Діапазони, яким ЗАРАЗ дозволені рівно наші порти.
current_allowed() {
  local to act from
  while IFS=$'\t' read -r to act from; do
    [ -n "$to" ] || continue
    case "$act" in ALLOW*) ;; *) continue ;; esac
    [ "$to" = "$PORTS/tcp" ] || continue
    is_anywhere "$from" && continue
    echo "$from"
  done < <(ufw_rows "$1") | sort -u
}

# Загальні дозволи на наші порти — те, що ми знімаємо.
#
# Без « (v6)»: `ufw status` друкує v4 і v6 двома рядками, але правило
# ОДНЕ — `ufw delete allow 80/tcp` знімає обидва, а команди
# `ufw delete allow 80/tcp (v6)` не існує.
blanket_rules() {
  local to act from
  while IFS=$'\t' read -r to act from; do
    [ -n "$to" ] || continue
    case "$act" in ALLOW*|LIMIT*) ;; *) continue ;; esac
    is_anywhere "$from" || continue
    opens_our_ports "$to"
    case $? in
      0) echo "$to" ;;
      2) die "у ufw є дозвіл усім на «$to», і я не вмію прочитати, які це порти — розберись руками, нічого не міняю" ;;
    esac
  done < <(ufw_rows "$1") | sort -u
}

ssh_is_allowed() {
  local to act from
  while IFS=$'\t' read -r to act from; do
    case "$act" in ALLOW*|LIMIT*) ;; *) continue ;; esac
    case "$to" in "$SSH_PORT"|"$SSH_PORT/tcp") return 0 ;; esac
  done < <(ufw_rows "$1")
  return 1
}

# ── план ──────────────────────────────────────────────────────────────
main() {
  local st want have add drop blanket
  st="$(ufw_status)"

  # 🔴 Перший замок — і він стоїть ДО читання чого завгодно з мережі.
  ssh_is_allowed "$st" \
    || die "у ufw немає дозволу на $SSH_PORT/tcp — машина налаштована не так, як я думаю; нічого не міняю"

  want="$(published)"
  have="$(current_allowed "$st")"
  blanket="$(blanket_rules "$st")"

  add="$(comm -23 <(echo "$want") <(echo "$have") || true)"
  drop="$(comm -13 <(echo "$want") <(echo "$have") || true)"

  local n_add n_drop n_blanket
  n_add="$(grep -c . <<<"$add" || true)"
  n_drop="$(grep -c . <<<"$drop" || true)"
  n_blanket="$(grep -c . <<<"$blanket" || true)"

  echo "діапазонів Cloudflare опубліковано: $(grep -c . <<<"$want")"
  echo "уже дозволено:                      $(grep -c . <<<"$have")"
  echo "додати:                             $n_add"
  echo "зняти (більше не публікуються):     $n_drop"
  echo "загальних дозволів на $PORTS:       $n_blanket"

  if [ "$CMD" = status ]; then
    if [ "$n_add" = 0 ] && [ "$n_drop" = 0 ] && [ "$n_blanket" = 0 ]; then
      echo "ВИСНОВОК: origin приймає лише Cloudflare"
      return 0
    fi
    echo "ВИСНОВОК: РОЗБІЖНІСТЬ"
    return 1
  fi

  if [ "$n_add" = 0 ] && [ "$n_drop" = 0 ] && [ "$n_blanket" = 0 ]; then
    echo "нічого робити"
    return 0
  fi

  if [ "$APPLY" = 0 ]; then
    echo "СУХИЙ ПРОГІН — нічого не змінено; додай --apply"
    while IFS= read -r c; do [ -n "$c" ] && echo "  + allow from $c to any port $PORTS proto tcp"; done <<<"$add"
    while IFS= read -r c; do [ -n "$c" ] && echo "  - delete allow from $c to any port $PORTS proto tcp"; done <<<"$drop"
    while IFS= read -r r; do [ -n "$r" ] && echo "  - delete allow $r   (загальний дозвіл)"; done <<<"$blanket"
    return 0
  fi

  # 🔴 ДОДАЄМО ПЕРШИМИ. Падіння посеред цього лишає сайт досяжним.
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    "$UFW" allow from "$c" to any port "$PORTS" proto tcp >/dev/null
  done <<<"$add"

  while IFS= read -r c; do
    [ -n "$c" ] || continue
    "$UFW" delete allow from "$c" to any port "$PORTS" proto tcp >/dev/null
  done <<<"$drop"

  # І аж тепер — загальний дозвіл, заради якого все й робилось.
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    "$UFW" delete allow "$r" >/dev/null
  done <<<"$blanket"

  # 🔴 Звіряємо ПІСЛЯ, зі свіжим читанням, а не з власного плану.
  st="$(ufw_status)"
  ssh_is_allowed "$st" || die "після зміни зник дозвіл на $SSH_PORT/tcp — це аварія, дивись ufw status"
  have="$(current_allowed "$st")"
  blanket="$(blanket_rules "$st")"
  if [ "$(sort -u <<<"$have")" != "$(sort -u <<<"$want")" ] || [ -n "$blanket" ]; then
    echo "ЗАСТОСОВАНО, АЛЕ ЗВІРКА НЕ ЗІЙШЛАСЬ — дивись ufw status numbered" >&2
    return 1
  fi
  echo "ЗАСТОСОВАНО: дозволено $(grep -c . <<<"$have") діапазонів, загальних дозволів 0"
}

main
