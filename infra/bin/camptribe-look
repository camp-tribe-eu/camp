#!/usr/bin/env bash
# Подивитись, що скаже сторож, НЕ надсилаючи власникові тривогу.
#
#   camptribe-look freshness      # сторож свіжості даних
#   camptribe-look infra-drift    # розбіжність репозиторію й машини
#   camptribe-look --list
#   camptribe-look --self-test
#
# 🔴 ЦЕЙ ФАЙЛ ІСНУЄ ЧЕРЕЗ ЛИСТ, ЯКИЙ Я НАДІСЛАВ ВЛАСНИКОВІ 03.11.2026.
#
# Я запустив `systemctl start camptribe-freshness.service`, щоб ПРОЧИТАТИ
# стан даних. Юніт відпрацював чесно: дані були протухлі, він вийшов з
# кодом 1, спрацював `OnFailure=camptribe-failed@` — і власник отримав
# «CampTribe: впало сторожів — 2».
#
# Тобто подивитись на сторожа тривоги означало підняти тривогу. Нічого
# не зламалось, лист був правдивий — і саме тому шкідливий: тривога, що
# приходить, коли ніхто нічого не ламав, за тиждень перестає читатись.
#
# 🔴 І «просто передати DATABASE_URL» — НЕ ВИХІД. `/proc` на цій машині
# без `hidepid`, тож `ps` будь-якого користувача читає argv усіх
# процесів (`docs/deploy.md`). Того ж дня я вже прогнав пароль бази
# через argv і мусив це визнати. `systemd-run --property=EnvironmentFile`
# дає тому ж юніту те саме оточення й не кладе секрет у argv.
#
# 🔴 ЧОМУ ПЕРЕЛІК ЗАКРИТИЙ, А НЕ «БУДЬ-ЯКИЙ ЮНІТ». Запустити цим
# `camptribe-osm-import` означало б тихо зробити роботу, яку хтось
# чекає від розкладу, і не лишити сліду в журналі юніта. Тут лише ті,
# що ЧИТАЮТЬ.
set -uo pipefail

# Ім'я → (юніт, команда). Обидва читають і нічого не пишуть.
looks() {
  cat <<'LIST'
freshness|camptribe-freshness.service|/usr/bin/node scripts/ci/check-data-freshness.mjs --db --stale-only
infra-drift|camptribe-infra-drift.service|/usr/local/bin/camptribe-infra-drift
LIST
}

row_for() { looks | awk -F'|' -v k="$1" '$1==k'; }

usage() {
  echo "camptribe-look <що> — подивитись без тривоги. Доступно:" >&2
  looks | cut -d'|' -f1 | sed 's/^/  /' >&2
}

run_look() {
  local name="$1" row unit cmd envfile user
  row="$(row_for "$name")"
  if [ -z "$row" ]; then
    echo "✗ невідомо, на що дивитись: ${name}" >&2
    usage
    return 2
  fi
  unit="$(printf '%s' "$row" | cut -d'|' -f2)"
  cmd="$(printf '%s' "$row" | cut -d'|' -f3)"
  # Оточення й користувача беремо З САМОГО ЮНІТА: другий перелік
  # розійшовся б із першим мовчки.
  envfile="$(systemctl show "$unit" -p EnvironmentFiles --value | sed 's/ (ignore_errors=.*)//')"
  user="$(systemctl show "$unit" -p User --value)"
  [ -n "${user}" ] || user=root
  local -a props=()
  [ -n "${envfile}" ] && props+=(--property=EnvironmentFile="${envfile}")
  props+=(--property=WorkingDirectory="$(systemctl show "$unit" -p WorkingDirectory --value)")
  # `--pipe` віддає вивід сюди, `--wait` — код завершення. Жодного
  # OnFailure: це окрема транзієнтна одиниця, не той юніт.
  systemd-run --quiet --pipe --wait --collect \
    --unit="look-${name}-$$" --uid="${user}" "${props[@]}" \
    ${cmd}
}

self_test() {
  local pass=0 fail=0
  t() { if [ "$2" = "$3" ]; then pass=$((pass+1)); printf '  ✓ %s\n' "$1";
        else fail=$((fail+1)); printf '  ✗ %s: «%s», мало бути «%s»\n' "$1" "$2" "$3"; fi; }

  t 'freshness є в переліку' "$(row_for freshness | cut -d'|' -f2)" 'camptribe-freshness.service'
  t 'infra-drift є в переліку' "$(row_for infra-drift | cut -d'|' -f2)" 'camptribe-infra-drift.service'
  t '🔴 невідоме імʼя не вгадується' "$(row_for osm-import)" ''
  # 🔴 Найважливіший випадок: у переліку НЕ МАЄ бути нічого, що пише.
  local writers
  writers="$(looks | grep -cE 'osm-import|route-poi|reconcile|retention|fuel-prices|air-quality|bathing' || true)"
  t '🔴 жодного юніта, що ПИШЕ, у переліку немає' "${writers}" '0'
  t 'перелік непорожній' "$(looks | grep -c . )" '2'

  printf '\ncamptribe-look self-test: ran %s, passed %s, failed %s\n' \
    "$((pass+fail))" "$pass" "$fail"
  [ "$fail" -eq 0 ]
}

case "${1:-}" in
  --self-test) self_test; exit $? ;;
  --list|'') usage; exit 2 ;;
  *) run_look "$1"; exit $? ;;
esac
