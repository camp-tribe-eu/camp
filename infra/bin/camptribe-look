#!/usr/bin/env bash
# Подивитись, що скаже сторож, НЕ надсилаючи власникові тривогу.
#
#   camptribe-look freshness      # сторож свіжості даних
#   camptribe-look infra-drift    # розбіжність репозиторію й машини
#   camptribe-look --list
#   camptribe-look --self-test
#
# 🔴 ЦЕЙ ФАЙЛ ІСНУЄ ЧЕРЕЗ ЛИСТ, ЯКИЙ Я НАДІСЛАВ ВЛАСНИКОВІ 03.11.2026.
#
# Я запустив `systemctl start camptribe-freshness.service`, щоб ПРОЧИТАТИ
# стан даних. Юніт відпрацював чесно: дані були протухлі, він вийшов з
# кодом 1, спрацював `OnFailure=camptribe-failed@` — і власник отримав
# «CampTribe: впало сторожів — 2».
#
# Тобто подивитись на сторожа тривоги означало підняти тривогу. Нічого
# не зламалось, лист був правдивий — і саме тому шкідливий: тривога, що
# приходить, коли ніхто нічого не ламав, за тиждень перестає читатись.
#
# 🔴 І «просто передати DATABASE_URL» — НЕ ВИХІД. `/proc` на цій машині
# без `hidepid`, тож `ps` будь-якого користувача читає argv усіх
# процесів (`docs/deploy.md`). Того ж дня я вже прогнав пароль бази
# через argv і мусив це визнати. `systemd-run --property=EnvironmentFile`
# дає тому ж юніту те саме оточення й не кладе секрет у argv.
#
# 🔴 ЧОМУ ПЕРЕЛІК ЗАКРИТИЙ, А НЕ «БУДЬ-ЯКИЙ ЮНІТ». Запустити цим
# `camptribe-osm-import` означало б тихо зробити роботу, яку хтось
# чекає від розкладу, і не лишити сліду в журналі юніта. Тут лише ті,
# що ЧИТАЮТЬ.
set -uo pipefail

# Ім'я → юніт. КОМАНДИ ТУТ НЕМАЄ, і це головна правка цього файла.
#
# 🔴 ТУТ СТОЯВ ДРУГИЙ ПЕРЕЛІК — рівно те, що забороняють рядки нижче.
# Третя колонка повторювала `ExecStart` юніта, і рецензія довела ціну:
# мутація команди на `--json --no-such-flag` лишала самотест зеленим
# 5/5. Тобто сторож перевіряв, що перелік збігається сам із собою.
#
# Тепер команда береться з юніта разом з оточенням і користувачем —
# звідки ж іще, адже саме його команду ми й хочемо подивитись.
looks() {
  cat <<'LIST'
freshness|camptribe-freshness.service
infra-drift|camptribe-infra-drift.service
LIST
}

# 🔴 ЧИ ПИШЕ ЦЕЙ ЮНІТ — ПИТАЄМО В ЙОГО КОМАНДИ, А НЕ В ЙОГО ІМЕНІ.
#
# Тут був чорний список із семи імен (`osm-import|route-poi|reconcile|…`).
# Рецензія додала `backup` із `/usr/local/bin/camptribe-backup --apply`
# і отримала зелені 5/5: писач пройшов, бо його імені в списку не було.
# Чорний список стереже те, що встигли назвати.
#
# Прапорець запису — це властивість КОМАНДИ, і вона читається. Сам
# перелік імен при цьому закритий і прибитий у самотесті, тож додати до
# нього будь-що, не зачепивши тест, теж не вийде.
writes_flag() {
  case " $1 " in
    *' --apply '*|*' --migrate '*|*' --write '*|*' --prune '*|*' --delete '*) return 0 ;;
    *) return 1 ;;
  esac
}

# Команда юніта, як її бачить systemd: `{ path=… ; argv[]=КОМАНДА ; … }`.
exec_start_of() {
  systemctl show "$1" -p ExecStart --value 2>/dev/null \
    | sed -n 's/.*argv\[\]=\(.*\) ; ignore_errors.*/\1/p' | head -1
}

row_for() { looks | awk -F'|' -v k="$1" '$1==k'; }

usage() {
  echo "camptribe-look <що> — подивитись без тривоги. Доступно:" >&2
  looks | cut -d'|' -f1 | sed 's/^/  /' >&2
}

run_look() {
  local name="$1" row unit cmd envfile user
  row="$(row_for "$name")"
  if [ -z "$row" ]; then
    echo "✗ невідомо, на що дивитись: ${name}" >&2
    usage
    return 2
  fi
  unit="$(printf '%s' "$row" | cut -d'|' -f2)"
  cmd="$(exec_start_of "$unit")"
  if [ -z "$cmd" ]; then
    echo "✗ не прочитати ExecStart у ${unit} — юніта немає або systemd мовчить" >&2
    return 2
  fi
  # 🔴 Відмова саме тут, а не в переліку імен: дивитись можна лише на те,
  # що читає. Якщо комусь колись знадобиться юніт із `--apply`, хай це
  # буде окремий свідомий інструмент, а не тихо «подивитись».
  if writes_flag "$cmd"; then
    echo "✗ ${unit} ПИШЕ (${cmd}) — camptribe-look лише дивиться" >&2
    return 2
  fi
  # Оточення й користувача теж беремо з юніта.
  envfile="$(systemctl show "$unit" -p EnvironmentFiles --value | sed 's/ (ignore_errors=.*)//')"
  user="$(systemctl show "$unit" -p User --value)"
  [ -n "${user}" ] || user=root
  local -a props=()
  [ -n "${envfile}" ] && props+=(--property=EnvironmentFile="${envfile}")
  props+=(--property=WorkingDirectory="$(systemctl show "$unit" -p WorkingDirectory --value)")
  # `--pipe` віддає вивід сюди, `--wait` — код завершення. Жодного
  # OnFailure: це окрема транзієнтна одиниця, не той юніт.
  systemd-run --quiet --pipe --wait --collect \
    --unit="look-${name}-$$" --uid="${user}" "${props[@]}" \
    ${cmd}
}

self_test() {
  local pass=0 fail=0
  t() { if [ "$2" = "$3" ]; then pass=$((pass+1)); printf '  ✓ %s\n' "$1";
        else fail=$((fail+1)); printf '  ✗ %s: «%s», мало бути «%s»\n' "$1" "$2" "$3"; fi; }

  t 'freshness є в переліку' "$(row_for freshness | cut -d'|' -f2)" 'camptribe-freshness.service'
  t 'infra-drift є в переліку' "$(row_for infra-drift | cut -d'|' -f2)" 'camptribe-infra-drift.service'
  t '🔴 невідоме імʼя не вгадується' "$(row_for osm-import)" ''

  # 🔴 ПЕРЕЛІК ЗАКРИТИЙ І ПРИБИТИЙ ТОЧНО. Чорний список стеріг лише ті
  # імена, які встигли назвати; цей випадок червоніє на БУДЬ-ЯКЕ
  # поповнення, зокрема на `backup`, яким рецензія й пробила старий.
  t '🔴 у переліку рівно двоє, і саме ці' \
    "$(looks | cut -d'|' -f1 | sort | tr '\n' ' ')" 'freshness infra-drift '

  # 🔴 Прапорець запису читається з команди, а не з імені.
  writes_flag '/usr/local/bin/camptribe-backup --apply'
  t '🔴 команда з --apply розпізнається як писач' "$?" '0'
  writes_flag '/usr/bin/node scripts/x.mjs --db --stale-only'
  t 'читальна команда писачем не вважається' "$?" '1'
  writes_flag '/usr/local/bin/camptribe-deploy deploy --sha abc --migrate'
  t '🔴 --migrate теж запис' "$?" '0'
  writes_flag '/usr/bin/node x.mjs --applyish'
  t 'схоже слово без межі не рахується' "$?" '1'

  # Розбір `ExecStart`, як його друкує systemd, — на зразку з машини.
  local sample='{ path=/usr/bin/node ; argv[]=/usr/bin/node a.mjs --db ; ignore_errors=no ; pid=1 }'
  t 'ExecStart розбирається з argv[]' \
    "$(printf '%s' "$sample" | sed -n 's/.*argv\[\]=\(.*\) ; ignore_errors.*/\1/p')" \
    '/usr/bin/node a.mjs --db'

  printf '\ncamptribe-look self-test: ran %s, passed %s, failed %s\n' \
    "$((pass+fail))" "$pass" "$fail"
  [ "$fail" -eq 0 ]
}

case "${1:-}" in
  --self-test) self_test; exit $? ;;
  --list|'') usage; exit 2 ;;
  *) run_look "$1"; exit $? ;;
esac
