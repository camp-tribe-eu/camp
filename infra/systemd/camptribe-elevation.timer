[Unit]
Description=CampTribe fill missing campsite elevations, daily

[Timer]
# 🔴 ЩОДЕННО, А НЕ ПІСЛЯ ІМПОРТУ. Імпорт (вівторок 04:30 UTC) не викликає
# цей юніт: `ExecStartPost` імпорту означав би, що збій добору валить
# імпорт, а збій імпорту (реліз старший за 9 діб) — що добір не біжить
# узагалі. Незалежний щоденний прогін добирає те, що імпорт приніс, у
# той самий вівторок о 05:15 (імпорт працює ≈7 хвилин), а решту днів
# коштує секунду: «0 без висоти — нічого добирати». Запізнілий імпорт
# добереться наступної доби.
OnCalendar=*-*-* 05:15:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
