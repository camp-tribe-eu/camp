[Unit]
Description=CampTribe DATAtourisme campsites refresh, weekly

[Timer]
# 🔴 РАЗ НА ТИЖДЕНЬ ПІД ДЖЕРЕЛО, ЩО ЖИВЕ ЩОДНЯ, — і це навмисно.
#
# data.gouv.fr називає частоту набору `daily`; 13.11.2026 усі 13
# регіональних файлів мали мітку того ж ранку, 03:44–03:56 UTC. Але
# ЗМІСТ рухається повільно: за 50 діб між 24.09 і 13.11 з 8 151 запису,
# що лишився, хоч одне опубліковане значення змінилось у 303, а зникло
# 242 — близько 42 і 34 на тиждень. Щоденний оберт качав би 343 МБ, щоб
# переписати з десяток рядків.
#
# Бюджет сторожа — 10 діб; `check-freshness-has-a-filler.mjs` вимагає
# період СУВОРО менший: 168 год < 240 год, запас 3 доби.
#
# 🔴 СУБОТА 04:15 UTC. Вівторок — ланцюг OSM, середа — купання, четвер
# — тарифи, пʼятниця — камери. Субота вільна. 04:15 — після бекапу
# (03:30) і чистки (04:00), і ПІСЛЯ того, як джерело перезібрало файли
# (до 03:56 UTC, заміряно один ранок): раніше ми забирали б учорашні.
# Сторож свіжості о 06:00 уже бачить нову мітку.
OnCalendar=Sat *-*-* 04:15:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
