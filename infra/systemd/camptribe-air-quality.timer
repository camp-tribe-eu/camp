[Unit]
Description=CampTribe EEA air quality import, every three hours

[Timer]
# 🔴 КОЖНІ ТРИ ГОДИНИ, А НЕ ЩОГОДИНИ — І ЦЕ РІШЕННЯ ЗА ЧИСЛОМ.
#
# Бюджет сторінки — чотири години (`AIR_FRESH_FOR_HOURS`), тож добовий
# таймер не виконав би його ніколи. Погодинний виконав би, але коштував
# би 5,5 ГБ на добу з чужого безкоштовного джерела (230,6 МБ за прогін,
# заміряно автором імпортера). Три години дають 1,8 ГБ і лишаються
# всередині бюджету.
#
# 🔴 О :25, а не о рівній годині: о :17 ходить `camptribe-isr`, о :00
# збігаються половина чужих кронів у світі, і EEA це теж відчуває.
OnCalendar=*-*-* 00/3:25:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
