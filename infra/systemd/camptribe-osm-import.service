# Кемпінги: щотижневий імпорт останнього релізу OSM у `camping_spots`.
#
# 🔴 ЦЕ ТА ЛАНКА, ЯКОЇ НЕ БУЛО. `osm-weekly.yml` кожного понеділка будує
# екстракти й ПУБЛІКУЄ їх релізом — і на цьому його робота закінчується:
# у ньому немає жодного кроку, що торкається бази (це написано в його
# шапці й зроблено навмисно — раннер не має шляху до прод-БД). Реліз
# мав забирати той, хто тримає базу, і ніхто цього не робив за розкладом:
# воркфлоу 26.10 відпрацював `success` — і реліз `osm-2026-10-26`
# (27 з 27 країн, 48 863 кемпінги) пролежав без імпорту. Зелений прогін
# чесно казав «реліз зібрано», а читач цього рядка чув «дані оновлено».
#
# 🔴 ЧОМУ ТАЙМЕР НА МАШИНІ. Альтернативи — крок у воркфлоу (потребує відкрити
# базу на раннер або покласти SSH-ключ від прода в секрети репозиторію, що
# власник заборонив 26.10.2026) і самохостед-раннер (виконує код з
# репозиторію поруч із бойовою базою). Таймер `Persistent=true` ще й
# наздоганяє пропущений прогін після простою машини.
#
# 🔴 ВІК РЕЛІЗУ ПЕРЕВІРЯЄТЬСЯ (`--max-age-days 9`), І ЦЕ НЕ ПРИКРАСА. Імпорт
# пише `last_seen_at = момент запуску`, а не дату екстракту, і саме цю
# колонку читає сторож свіжості. Якби понеділковий воркфлоу тижнями падав,
# таймер щотижня ввозив би той самий старий реліз, ставив би всім 63 тисячам
# рядків «побачено щойно», і сторож рапортував би «свіжо» над місячними
# даними. З межею юніт падає — і це тривога: один пропущений цикл
# (реліз 8 діб) ще проходить, два — ні.
#
# 🔴 ПРО ЗАПИСИ. Імпорт НЕ видаляє кемпінги: це upsert по `osm_ref` і
# позначка `missing_since` для тих, кого екстракт не згадав (410 лише після
# чотирьох таких тижнів поспіль). Робоча таблиця `osm_camping_staging` — це
# його власний чернетковий стіл, який кожна країна перестворює; сайт її не
# читає. Країни ввозяться по черзі, одна зіпсована коштує лише себе, а код
# виходу ненульовий, якщо хоч одна не ввезена — юніт падає, і це тривога.
#
# 🔴 `reconcile-sources --apply` (таблиця `spot_links`) ТУТ НАВМИСНО НЕМАЄ.
# Він не імпортує дані, а ВИРІШУЄ, що два записи — один кемпінг, і сторінки
# зливаються. Сухий прогін 28.10.2026 на цій базі: 76 нових звʼязків, і сам
# скрипт друкує верхню межу хибних — 16,7%. Попередні пачки (2 986 і 629)
# ввозились вручну. Автоматизувати вирок без людини — рішення власника, а не
# деталь розкладу.
#
# 🔴 ВАРТІСТЬ, заміряна 28.10.2026 на цій машині (4 ядра, 7,7 ГБ, навантаження
# 0,04 до запуску), реліз osm-2026-10-26, усі 27 країн, `Nice=10`:
# 6 хв 38 с стінного часу; 45 с процесорного часу самого імпортера (і його
# дочірніх процесів); найбільший процес — 261 МБ resident. Основне навантаження
# — Postgres: один його процес тримає ядро на 98% (кожен кемпінг — окремий
# upsert), решта ядер вільна. Диск: реліз 9 МБ, нічого не накопичується.
# Повторний прогін на тих самих даних: `inserted 0` майже скрізь.
# Щоночі це було б зайвим — екстракт будується раз на тиждень.
[Unit]
Description=CampTribe weekly OSM campsite import
After=postgresql.service network-online.target
Wants=network-online.target
OnFailure=camptribe-failed@%n.service

[Service]
Type=oneshot
User=camptribe
Group=camptribe
WorkingDirectory=/srv/camptribe/current/apps/api
EnvironmentFile=/srv/camptribe/current/apps/api/.env
# Поруч живий сайт: імпорт не конкурує з ним ні за процесор, ні за диск.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
ExecStart=/usr/bin/node /srv/camptribe/current/scripts/osm-pipeline/import-release.mjs --max-age-days 9
# 🔴 Слід знімається лише після УСПІШНОГО прогону: для Type=oneshot
# ExecStartPost не біжить, якщо ExecStart повернув ненуль.
ExecStartPost=/bin/rm -f /srv/camptribe/failed/camptribe-osm-import.service
