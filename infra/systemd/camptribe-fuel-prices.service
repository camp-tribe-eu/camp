# Ціни пального на станціях (ES/FR/IT): щоденне оновлення таблиці
# `fuel_station_prices`.
#
# 🔴 ЧОМУ ЦЕ ЮНІТ НА МАШИНІ, А НЕ КРОК У data-refresh.yml. Воркфлоу
# `data-refresh` оновлює ФАЙЛИ в репозиторії (`fuel-prices.json` — середні
# по країні). Ця таблиця — інше: 80 тисяч рядків по станціях, звʼязаних із
# `osm_route_poi` у БАЗІ. Раннер до бази не дотягнеться, і це навмисно:
# тримати для цього доступ до прод-БД на стороннього раннера означає
# відкривати базу в інтернет заради крону. Джерела — три публічні відкриті
# ендпойнти без ключа, їх машина читає сама.
#
# 🔴 ЦЕ БУЛО ЛЮДСЬКИМ КРОКОМ. Таблиця протухла на 15 діб (бюджет 2), бо її
# оновлював той, хто пам'ятав запустити `import-stations`. Заміряно
# 28.10.2026: при першому ж ручному запуску на проді імпорт упав — Іспанія
# пише годину без нуля (`7:51:01`), парсер читав лише `07:51:01`, і з 03:00
# до 10:00 за Мадридом жодна іспанська станція не проходила. Таймер о
# 05:00 UTC влучав би рівно в це вікно щодня.
#
# 🔴 ЯК ВОНО ПОВОДИТЬСЯ, КОЛИ ДЖЕРЕЛО НЕДОСЯЖНЕ. Заміряно тоді ж: сайт
# mimit.gov.it (Італія) не відповідав на TCP ні з машини, ні з ноутбука.
# Імпортер читає джерела окремо: Іспанія й Франція оновлюються, італійські
# рядки лишаються як були (з їхньою датою — сторінка сама позначає
# застарілу ціну), у журналі — що саме не оновлено. Юніт при цьому НЕ
# падає: про застарілу країну скаже сторож свіжості, який читає вік
# КОЖНОГО джерела окремо і дзвонить, коли найстаріше вийшло за 2 доби.
# Дві тривоги про одну аварію — це два листи на день, і другий перестають
# читати.
#
# 🔴 ПРО ВИДАЛЕННЯ. Імпорт замінює рядки джерела цілком (DELETE + INSERT в
# одній транзакції, тільки для джерел, прочитаних сьогодні): станція, що
# перестала публікувати, мусить втратити ціну, а не тримати вчорашню.
# Рядки джерела, яке не прочиталось, не чіпаються. Транзакція відкочується
# цілком, якщо збилось зіставлення з `osm_route_poi` (MIN_MATCH_RATE).
#
# Вартість, заміряна 28.10.2026 на цій машині: 23 с стінного часу, 3 с CPU,
# три завантаження (12 МБ, 4,6 МБ, ~3 МБ), одна транзакція.
[Unit]
Description=CampTribe fuel station prices refresh (ES, FR, IT)
After=postgresql.service network-online.target
Wants=network-online.target
OnFailure=camptribe-failed@%n.service

[Service]
Type=oneshot
User=camptribe
Group=camptribe
WorkingDirectory=/srv/camptribe/current/apps/api
EnvironmentFile=/srv/camptribe/current/apps/api/.env
# Поруч живий сайт; цей юніт не конкурує з ним за процесор.
Nice=10
# Три завантаження по 180 с кожне — стеля, а не очікування.
TimeoutStartSec=20min
ExecStart=/usr/bin/node dist/fuel/import-stations.js --report
# 🔴 Слід знімається лише після УСПІШНОГО прогону: для Type=oneshot
# ExecStartPost не біжить, якщо ExecStart повернув ненуль.
ExecStartPost=/bin/rm -f /srv/camptribe/failed/camptribe-fuel-prices.service
