# CAMP-170: щоденне питання «який імпортер замовк».
#
# 🔴 ЦЕ ПРО ТЕ, ЩО ВИГЛЯДАЄ ЗДОРОВИМ. Жоден із імпортерів, зупинившись,
# нічого не ламає помітно: сторінка покаже ціну, кемпінг, маршрут.
# Просто числа будуть старі, і ніхто про це не дізнається, поки хтось
# не приїде на заправку.
#
# 🔴 CAMP-399: ЦЕЙ ЮНІТ ТРИ ТИЖНІ ПЕРЕДАВАВ ПРАПОРЕЦЬ, ЯКОГО СКРИПТ НЕ
# ЗНАВ. Переписування #340 (25.10.2026) залишило в скрипті два JSON і
# викинуло `--stale-only` разом із таблицями — а аргумент мовчки
# ковтався, і таймер щодня рапортував успіх над двома файлами з
# одинадцяти джерел. Тепер невідомий аргумент — збій (код 2), і такий
# розрив упав би в перший же ранок після деплою.
#
# 🔴 `--db` — ЯВНО. Таблиці читаються лише за прапорцем, а не «коли є
# DATABASE_URL»: інакше втрата змінної в .env осліпила б сторожа мовчки.
# Без змінної він тепер падає з реченням, а не пропускає.
#
# 🔴 ЧОМУ `--stale-only`, А НЕ ПОВНИЙ ЗВІТ. Порожня таблиця означає, що
# імпортер не запускався ЖОДНОГО РАЗУ — це відсутній крок налаштування,
# і повторний запуск його не лагодить. Заміряно 27.10.2026 на локальній
# camptribe_dev: 5 із 9 таблиць порожні (ціни станцій, камери Windy,
# купання, повітря ×2), 3 за бюджетом, 1 у межах. Падіння цього юніта
# з CAMP-394 — це лист власнику. Пʼять листів щодня про те, чого ніколи
# не було, перестали б читатись за тиждень — рівно тоді, коли вперше
# знадобляться. Тому таймер дзвонить на те, що ПРАЦЮВАЛО Й ЗУПИНИЛОСЬ;
# «не запускався» лишається у звіті та в journal. Повний вирок — без
# прапорця: `node scripts/ci/check-data-freshness.mjs --db`.
[Unit]
Description=CampTribe data freshness check
After=postgresql.service
OnFailure=camptribe-failed@%n.service

[Service]
Type=oneshot
User=camptribe
Group=camptribe
WorkingDirectory=/srv/camptribe/current
EnvironmentFile=/srv/camptribe/current/apps/api/.env
ExecStart=/usr/bin/node scripts/ci/check-data-freshness.mjs --db --stale-only
# 🔴 Слід знімається лише після УСПІШНОГО прогону. Для Type=oneshot
# ExecStartPost не біжить, якщо ExecStart повернув ненуль — тож
# вчорашня тривога не зникає сама від того, що юніт просто стартував.
ExecStartPost=/bin/rm -f /srv/camptribe/failed/camptribe-freshness.service
