[Unit]
Description=CampTribe weekly OSM route-POI import

[Timer]
# Вівторок, бо воркфлоу `osm-weekly` будує реліз у понеділок о 04:00 UTC і
# працює до години (Німеччина — 21 хв на 26.10, плюс черга з чотирьох
# паралельних). 05:30 — через годину після імпорту кемпінгів (04:30, ~7 хв
# на 28.10), щоб два імпорти не ділили одне ядро Postgres, і за пів години
# до сторожа свіжості (06:00), який о цій порі вже бачить нові числа.
OnCalendar=Tue *-*-* 05:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
