# Щонічний деплой: викотити main, якщо він змінився з минулого разу.
#
# 🔴 ЦЕ ДРУГИЙ РОЗРИВ ЛАНЦЮГА ДАНИХ. `data-refresh` (GitHub, щодня) готує PR
# з файлами пожеж, посухи й цін пального і сам його зливає. Але сайт
# статичний: дані потрапляють на сторінки лише з ПОВНОЮ ЗБІРКОЮ, а її
# запускали руками. Злите, але не викочене — для читача те саме, що
# не оновлене: `wildfires.json` протух на 4,3 доби при бюджеті 3.
#
# 🔴 ЧОМУ ЮНІТ НА МАШИНІ, А НЕ ВОРКФЛОУ З КЛЮЧЕМ. Рішення власника
# 26.10.2026: ключ від прода в секретах CI не живе. Тривога й дії йдуть З
# машини назовні, а не ззовні всередину. Машина питає публічний GitHub (без
# облікових даних), чи змінився main, і лише тоді будує.
#
# 🔴 ЩО ТУТ НЕ ПЕРЕВІРЕНО Й НЕ ВИКОНУЄТЬСЯ:
#   • `--migrate` немає. Міграція — рішення людини; без неї deploy відмовить
#     ДО збірки, юніт упаде, лист піде.
#   • Реліз збирається ПОРУЧ із живим (окрема тека, перемикання симлінка),
#     відкат лишається таким самим, як у ручного деплою: `camptribe-deploy
#     rollback`. Автовідкат при невдалій перевірці — теж звідти.
#   • Від root, бо `camptribe-deploy` перезапускає служби й перемикає
#     симлінк; користувачу `camptribe` це недоступне. Сам скрипт переходить
#     на `camptribe` для git і збірки, як і при ручному запуску.
#
# 🔴 Падіння тут — НЕ «щось не так із сайтом»: сайт лишається на попередньому
# релізі. Падіння означає «нова версія не викотилась», і лист про це —
# єдиний спосіб дізнатись.
[Unit]
Description=CampTribe nightly deploy of main (only if main changed)
After=network-online.target postgresql.service camptribe-api.service camptribe-web.service
Wants=network-online.target
OnFailure=camptribe-failed@%n.service

[Service]
Type=oneshot
# Збірка ~400 с (заміряно 12.10.2026); стеля з великим запасом, бо поруч
# живий сайт ділить процесор, а зависла збірка гірша за довшу.
TimeoutStartSec=45min
# Поруч живий сайт; збірка не конкурує з ним за процесор і диск.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/local/bin/camptribe-deploy-nightly
# 🔴 Слід знімається лише після УСПІШНОГО прогону: для Type=oneshot
# ExecStartPost не біжить, якщо ExecStart повернув ненуль. Ніч без змін
# теж успіх — вчорашня тривога знімається тоді, коли деплой справді відбувся
# або коли нічого було викочувати.
ExecStartPost=/bin/rm -f /srv/camptribe/failed/camptribe-deploy-nightly.service
