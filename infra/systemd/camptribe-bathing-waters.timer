[Unit]
Description=CampTribe EEA bathing water import, weekly

[Timer]
# 🔴 ЩОТИЖНЯ ПРИ РІЧНОМУ ДЖЕРЕЛІ — І ЦЕ НЕ НАДМІРНІСТЬ.
#
# Класифікація публікується раз на рік (`ANNUAL_HEALTHY_DAYS = 365`),
# тож бюджет величезний і майже будь-який розклад його виконує. Тижневий
# обрано не заради свіжості даних, а заради того, щоб ПОЛАМАНИЙ збирач
# знайшовся за тиждень, а не за рік: юніт, що ходить раз на рік, за
# життя проєкту спрацює двічі, і перший збій буде видно в наступному
# сезоні.
#
# Середа, щоб не збігатися з вівторковим ланцюгом OSM.
OnCalendar=Wed *-*-* 05:20:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
