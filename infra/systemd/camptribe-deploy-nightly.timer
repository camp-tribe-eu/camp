[Unit]
Description=CampTribe nightly deploy of main, once a day

[Timer]
# 🔴 13:00 UTC, І ЦЕ ПРО ЧУЖИЙ РОЗКЛАД, А НЕ ПРО СМАК. `data-refresh` у
# `cron` стоїть о 04:17 UTC, але GitHub запускає заплановані завдання з
# великим запізненням. Заміряно `gh api repos/camp-tribe-eu/camp/actions/
# workflows/data-refresh.yml/runs`: три прогони за розкладом стартували
# о 09:53 (27.10), 10:39 (28.10) і 10:57 UTC (29.10) — через 5,6, 6,4 і
# 6,7 години після 04:17. Деплой о 05:00 щоразу вивозив би ВЧОРАШНІ дані.
# 13:00 дає запас у ~2 години над найгіршим із заміряного.
# Це не гарантія: якщо GitHub запізниться ще більше, дані поїдуть
# наступної доби — і це видно в журналі (deploy друкує коміт).
#
# Не у вікні 03:30 (бекап), 05:00 (ціни пального), 06:00 (сторож свіжості),
# 06:30 (дрейф покриття) і не на хвилині :17 (щогодинна проба ISR).
OnCalendar=*-*-* 13:00:00 UTC
# 🔴 Persistent: машину вимкнено о 13:00 — деплой наздожене при старті.
Persistent=true

[Install]
WantedBy=timers.target
