# CAMP-337: тримати список діапазонів Cloudflare актуальним у ufw.
#
# 🔴 СКРИПТ БЕЗ ТАЙМЕРА — НЕ МЕХАНІЗМ ОНОВЛЕННЯ. Картка каже прямо:
# «списки змінюються рідко; потрібен скрипт оновлення, інакше одного
# дня сайт впаде сам від себе». Cloudflare додасть мережу, ufw про неї
# не знатиме, і трафік звідти почне мовчки відкидатись — частковий збій,
# який виглядає випадковим і діагностується найгірше.
#
# 🔴 ЧОМУ --apply, А НЕ ЛИШЕ ПЕРЕВІРКА. Тривога, яку ніхто не читає,
# тут дорожча за автоматичну правку: між «Cloudflare додав мережу» і
# «я це помітив» лежить саме те вікно, заради якого картка й заведена.
# Безпеку дають не ручні очі, а підлоги в самому скрипті: порожній
# список, сторінка помилки замість нього, обрізаний список чи мовчання
# curl — це ВІДМОВА, а не «застосувати нуль правил».
#
# 🔴 ЧОМУ root. `ufw` без root не читає стан і не міняє правил. Це
# єдиний юніт у проєкті від root, і він запускає рівно один виконуваний
# файл, який не приймає вводу ззовні, крім двох опублікованих списків
# Cloudflare — і кожен рядок у них перевіряється на форму.
#
# 🔴 ЩО ТО ЗНАЧИТЬ, КОЛИ ЮНІТ ВПАВ. Одне з двох, і обидва вимагають
# людини, а не повтору:
#   · Cloudflare віддав не список (підлоги 10/4 не зійшлись, або рядок
#     не схожий на мережу) — origin лишився з учорашніми правилами,
#     сайт працює, але список застаріває;
#   · у ufw зник дозвіл на 22/tcp — машину хтось переналаштував, і
#     скрипт свідомо зупинився, не чіпаючи нічого.
# Подивитись: `camptribe-firewall status` на машині.
[Unit]
Description=CampTribe origin firewall: allow only Cloudflare ranges
After=network-online.target
Wants=network-online.target
OnFailure=camptribe-failed@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/camptribe-firewall sync --apply
# 🔴 Слід знімається лише після УСПІШНОГО прогону: для Type=oneshot
# ExecStartPost не біжить, якщо ExecStart повернув ненуль, тож учорашня
# тривога не зникає від того, що юніт просто стартував.
ExecStartPost=/bin/rm -f /srv/camptribe/failed/camptribe-firewall.service
