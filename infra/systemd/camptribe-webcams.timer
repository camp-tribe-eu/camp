[Unit]
Description=CampTribe Windy webcams refresh, weekly

[Timer]
# 🔴 РАЗ НА ТИЖДЕНЬ — НАЙРІДШЕ, ЩО ВИКОНУЄ БЮДЖЕТ, І ЦЕ НАВМИСНО.
#
# Бюджет `webcams` — 10 діб. Сторож `check-freshness-has-a-filler.mjs`
# вимагає період СУВОРО менший за бюджет і розуміє три форми календаря:
# щогодини, щодня, щотижня. 168 год < 240 год — запас 3 доби на затримку
# таймера. Частіше (двічі на тиждень, щодня) дало б запас на цілий
# пропущений оберт, але це той самий обхід 815 регіонів удвічі-всемеро
# частіше, а умови Windy називають порушенням саме «continuous scanning»
# і «intensive usage … by means of automated software», без числа. Тож
# пропущений оберт коштує червоного рядка й ручного `systemctl start`, а
# не ключа.
#
# 🔴 ПʼЯТНИЦЯ 04:15 UTC. Вівторок — ланцюг OSM, середа — купання, четвер
# — тарифи. 04:15 — після бекапу (03:30) і чистки (04:00); оберт іде
# близько 37 хв (заміряно 02.11.2026) і кінчається до АЗС (05:00) і
# задовго до сторожа свіжості (06:00), який тоді вже бачить нову
# `fetched_at`.
OnCalendar=Fri *-*-* 04:15:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
