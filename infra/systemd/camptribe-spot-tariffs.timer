[Unit]
Description=CampTribe DATAtourisme tariffs refresh, weekly

[Timer]
# 🔴 ЧЕТВЕР, А НЕ ВІВТОРОК. Вівторок уже несе ланцюг OSM (04:30 кемпінги,
# 05:30 POI, 05:50 звʼязки, до години кожен) на одному ядрі Postgres;
# середа — купання EEA (05:20). Тарифам OSM не потрібен: вони лягають на
# кемпінги, які вже мають ref DATAtourisme, і цей перелік тижневий імпорт
# OSM не змінює.
#
# 05:10 — після денного бекапу (03:30) і АЗС (05:00, ~23 с), до сторожа
# інфраструктури (05:45) і сторожа свіжості (06:00), який о цій порі вже
# бачить нову `fetched_at`. Увесь юніт — близько хвилини (14 с + 44 с,
# заміряно на машині); стеля 30 хв у юніті все одно закінчується до 06:00.
#
# Раз на тиждень при бюджеті 10 діб: запас 3 доби на затримку таймера чи
# один невдалий оберт — і сторож `check-freshness-has-a-filler.mjs`
# перевіряє цю нерівність (168 год < 240 год) на кожному PR.
OnCalendar=Thu *-*-* 05:10:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
