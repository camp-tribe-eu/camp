[Unit]
Description=CampTribe ISR hook check, hourly

[Timer]
# 🔴 ЩОГОДИНИ, А НЕ ЩОДОБИ, І ЦІНА НАЗВАНА. Проба сама скидає мітку, тож
# витримка контенту фактично стає годиною замість доби — читачеві це на
# користь. Зворотний бік назвати теж чесно: поки проба підтримує
# свіжість, мертвий ПОТІК у Directus лишиться непоміченим, бо контент
# однаково оновиться за годину. Потік перевіряється окремо, з боку
# Directus, і це ще не зроблено (див. CAMP-363, п. 1 способу перевірки).
OnCalendar=*-*-* *:17:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
