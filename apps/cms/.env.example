KEY=
SECRET=

DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=camptribe_dev
DB_USER=

ADMIN_EMAIL=
ADMIN_PASSWORD=

PORT=8055
# Активація ліцензії прив'язується до бази даних + PUBLIC_URL, а не до контейнера.
# Змінив PUBLIC_URL — витратив ще одну активацію з п'яти. Див. CAMP-62.
PUBLIC_URL=http://localhost:8055

# Ключ Open Innovation Grant. Справжнє значення живе тільки в .env (він у .gitignore).
# У .env.example лишається порожнім — сюди ключ не вписувати ніколи.
LICENSE_KEY=

# 🔴 РОЗШИРЕННЯ НЕ СТАВИМО. Єдина критична вразливість Directus — tar
# усередині @directus/api (шлях-траверсал при розборі архівів). Прибрати
# її не можна: npm «лікує» відкотом на 10.9.3, тобто ніяк. Єдине, що
# справді розпаковує чужі архіви, — встановлення розширень із маркетплейсу.
#
# Змінної, яка вимикає маркетплейс цілком, у Directus НЕМАЄ (перевірено
# 20.10.2026 по docs/configuration/extensions). Є лише ці дві, і вони
# стоять тут явно, а не покладаються на замовчування:
MARKETPLACE_TRUST=sandbox
#
# 🔴 ПРЕФІКС string: ОБОВʼЯЗКОВИЙ, І ЦЕ НЕ ОХАЙНІСТЬ.
# Вендор пише так: `const limit = env[...] ? Number(env[...]) : null`, і
# перевірку виконує ЛИШЕ коли значення правдиве. Без префікса «0»
# вгадується як JSON і стає ЧИСЛОМ 0, тобто хибним, — і перевірка
# пропускається ЦІЛКОМ. Тобто EXTENSIONS_LIMIT=0 означає «ліміту немає».
# Заміряно 20.10.2026: «0» → дозволено, «string:0» → заблоковано.
EXTENSIONS_LIMIT=string:0

# 🔴 Активація прив'язується до бази даних + PUBLIC_URL, а не до
# контейнера. Активацій п'ять, і знищений без деактивації інстанс тримає
# слот НАЗАВЖДИ. Локально працюємо БЕЗ ключа, на Core — перевірити можна
# публічним GET /server/info: license.source === null означає Core.

# ─────────────────────────────────────────────────────────────────────
# CAMP-384: ЩО ДОДАЄТЬСЯ НА БОЙОВІЙ МАШИНІ (/srv/camptribe/cms/.env).
# Локально ці рядки НЕ потрібні — вони тільки для cms.camptribe.eu.

# 🔴 ЦЕЙ ФАЙЛ ПЕРЕВАЖУЄ systemd, А НЕ НАВПАКИ. Заміряно у вендорі
# (@directus/env, createEnv): `{ ...process.env, ...fileConfiguration }`
# — тобто .env кладеться ПОВЕРХ усього, що дав юніт. Отже саме тут
# вирішується, на чому CMS висить, і помилка тут видимо нічого не
# ламає, доки хтось не знайде адмінку з інтернету.
# Перевіряти: `camptribe-cms status` питає ядро, а не цей файл.
HOST=127.0.0.1
PORT=8055

# 🔴 PUBLIC_URL — ЧАСТИНА КЛЮЧА АКТИВАЦІЇ, а не косметика. Вендор шле
# `activateKey({ license_key, project_id, public_url })`
# (@directus/api/dist/license/manager.js:209). `project_id` лежить у
# directus_settings, тобто В БАЗІ. Пара «project_id + PUBLIC_URL» і є
# тим, до чого прив'язаний слот. Змінив адресу — витратив ще одну
# активацію з п'яти, і назад їх не видають.
PUBLIC_URL=https://cms.camptribe.eu

# 🔴 БЕЗ ЯВНОГО SECRET СЕСІЇ НЕ ПЕРЕЖИВАЮТЬ РЕСТАРТ. Directus генерує
# випадковий при кожному старті — це пряма вимога їхньої документації
# для продакшну, а не наша обережність. Генерувати:
#   node node_modules/directus/cli.js security secret:generate
SECRET=

# 🔴 ЗА HTTPS COOKIE МУСЯТЬ БУТИ Secure, А ЗАМОВЧУВАННЯ — false.
# Заміряно: @directus/env/dist/index.js:57 і :61 → обидва `false`.
# Тобто без цих рядків сесійна cookie полетіла б і по голому HTTP.
SESSION_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SECURE=true

# 🔴 БАЗА — ТА САМА, ЩО В ЗАСТОСУНКУ, І ЦЕ НЕ НЕДОГЛЯД.
# Наші міграції володіють DDL, Directus лише реєструє ці таблиці як
# колекції (apps/api/src/entities/content.entity.ts:4). Заміряно
# 22.10.2026 локально: directus_collections = 29 рядків, і ВСІ 29 —
# наші таблиці, жодної системної. Окрема база для CMS означала б, що
# Directus не бачить контенту взагалі.
# DB_* беруться з того ж DATABASE_URL, яким живе API.
