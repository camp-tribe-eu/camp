DATABASE_URL=postgres://localhost:5432/camptribe_dev
PORT=3001

# Транзакційна пошта: підтвердження адреси й скидання пароля (CAMP-228).
#
# 🔴 ПРОВАЙДЕРА ЩЕ НЕМАЄ, і це не блокує код. Рішення CAMP-110 (24.09.2026):
# Resend, другим релеєм SMTP2GO, локальний Postfix як черга; **Brevo відпав**
# (чужий бейдж у листі скидання пароля). Колишній текст у цьому файлі називав
# Brevo й `SMTP_*` для нього — він застарів і прибраний. Відправник
# підключається в `auth/mail.ts` (`mailerFrom`) разом із CAMP-110.
#
# `MAIL_PROVIDER` порожній — це не «за замовчуванням dev»: реєстрація, «забули
# пароль» і «надіслати ще раз» відповідають 503, а рядок `[mail] NOT CONFIGURED`
# у логу запуску каже чому. `dev` — листи в памʼять і в консоль, лише в
# розробці й CI, і при NODE_ENV=production API відмовляється.
MAIL_PROVIDER=
# Звідки беруться посилання в листах. З конфігурації, НІКОЛИ із запиту: інакше
# `Host: evil.example` дає справжній лист зі справжнім токеном на чужий домен.
WEB_BASE_URL=http://localhost:3000
MAIL_FROM=hello@camptribe.eu
MAIL_FROM_NAME=CampTribe
