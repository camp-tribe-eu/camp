DATABASE_URL=postgres://localhost:5432/camptribe_dev
PORT=3001

# Транзакційна пошта: підтвердження адреси й скидання пароля (CAMP-228, CAMP-110).
#
# `MAIL_PROVIDER`: `dev` або `smtp`. Інших відправників у збірці немає.
# Порожній — це не «за замовчуванням dev»: реєстрація, «забули пароль» і
# «надіслати ще раз» відповідають 503, а рядок `[mail] NOT CONFIGURED` у логу
# запуску каже чому. `dev` — листи в памʼять і в консоль, лише в розробці й CI,
# і при NODE_ENV=production API відмовляється.
MAIL_PROVIDER=
# Звідки беруться посилання в листах. З конфігурації, НІКОЛИ із запиту: інакше
# `Host: evil.example` дає справжній лист зі справжнім токеном на чужий домен.
WEB_BASE_URL=http://localhost:3000

# ── MAIL_PROVIDER=smtp: SMTP-сервер Hetzner через nodemailer (CAMP-110) ──
# Шість змінних нижче ОБОВʼЯЗКОВІ. Бракує хоч однієї — API стартує, у логу
# запуску `[mail] NOT CONFIGURED (… needs these set: SMTP_USER)` з назвами
# всього, чого бракує (значення не друкуються ніколи), а реєстрація й скидання
# пароля відповідають 503. Тихого відкату на `dev` немає.
#
# Сервер і порт. Приймаються лише 465 (TLS із першого байта) і 587 (STARTTLS,
# і без нього зʼєднання відмовляється, а не йде відкритим текстом). Сертифікат і
# імʼя хоста перевіряються завжди. `SMTP_HOST` — голе імʼя: без `smtp://`,
# без `:порт`.
#
# 🔴 587, А НЕ 465 — І МІРЯТИ ЦЕ ТРЕБА З СЕРВЕРА. www784.your-server.de
# резолвиться для нашої машини в IPv6 (адреса в документі не наводиться — CAMP-355), а по IPv6
# відповідає ЛИШЕ 587: 465 і 25 мовчать. З ноутбука (IPv4) відкриті обидва —
# саме тому 16.10.2026 тут стояло 465, і кожен лист падав у
# SmtpSendFailed_ETIMEDOUT. Заміряно на обох машинах.
SMTP_HOST=www784.your-server.de
SMTP_PORT=587
# Логін скриньки, який видав Hetzner (не пароль).
SMTP_USER=
# 🔴 ПАРОЛЬ ЛИШЕ З ОТОЧЕННЯ СЕРВЕРА. У цьому файлі він порожній назавжди,
# репозиторій публічний; `mail-smtp.spec.ts` падає, якщо тут зʼявиться значення.
# Ніде не друкується: ні в логу запуску, ні в тексті помилки відправки.
SMTP_PASSWORD=
# Від кого лист. Справжня скринька (з копією власникові), а не чорна діра.
MAIL_FROM=noreply@camptribe.eu
# Імʼя поруч з адресою. Єдина необовʼязкова: порожня — `CampTribe`.
MAIL_FROM_NAME=CampTribe
# Куди йде відповідь на лист. Обовʼязкова: люди відповідають і на `noreply@`.
MAIL_REPLY_TO=hello@camptribe.eu

# ───────────────────────────────────────────────────────────────────────
# 🔴 NEXT_PUBLIC_* — ЦЕ НАЛАШТУВАННЯ ВЕБУ, І ВОНИ ЖИВУТЬ ТУТ НАВМИСНО.
# `infra/bin/camptribe-deploy` збирає веб із цього ж файлу; будь-який
# ключ у строгій формі NEXT_PUBLIC_<ВЕЛИКІ>= їде у збірку автоматично,
# переліку в скрипті немає (CAMP-340: зашитий перелік не пускав сюди
# жодної з них, і акаунти на проді не працювали жодного дня).
#
# 🔴 ЦІ ЗНАЧЕННЯ ЗАПІКАЮТЬСЯ У СТАТИКУ ПІД ЧАС ЗБІРКИ. Змінити їх на
# машині після деплою неможливо — лише нова збірка.
#
# Порожнє значення здебільшого не помилка, а тихо ввімкнене запасне —
# саме так їх і не помітили. ВИНЯТОК один: без NEXT_PUBLIC_API_BASE_URL
# деплой ВІДМОВЛЯЄ ще до перемикання (build_web у
# infra/bin/camptribe-deploy), бо порожня адреса означає непрацюючі
# акаунти, і мовчати про це більше не можна.

# Звідки браузер бере API. Спільне походження (/api на тому самому домені),
# тож CORS не вмикається, а CSP `connect-src 'self'` уже це покриває.
# Caddy зрізає префікс: `handle_path /api/*` → 127.0.0.1:3001.
# Порожнє = акаунти у браузері мовчки не працюють.
NEXT_PUBLIC_API_BASE_URL=https://camptribe.eu/api

# Куди браузер шле звіти про помилки (CAMP-92). Порожнє = вимкнено.
NEXT_PUBLIC_ERROR_ENDPOINT=https://camptribe.eu/api/client-errors

# `public` робить збірку індексовною. 🔴 Це ЛИШЕ ПЕРШИЙ із двох замків:
# другий — `X-Robots-Tag` у `gate-closed.conf`, і зняти треба обидва.
NEXT_PUBLIC_SITE_MODE=closed

# Канонічний домен. Запасне значення таке саме, лишаємо явно.
NEXT_PUBLIC_SITE_URL=https://camptribe.eu

# Тайли мапи. Запасне значення для першої — openfreemap; друга порожня
# вимикає власні тайли. Названі тут, бо веб їх читає
# (apps/web/src/lib/map-sources.ts), а не описана змінна — це змінна,
# яку наступного разу шукатимуть у коді.
NEXT_PUBLIC_TILES_URL=https://tiles.openfreemap.org
NEXT_PUBLIC_SELF_TILES_URL=
