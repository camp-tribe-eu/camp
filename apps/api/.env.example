DATABASE_URL=postgres://localhost:5432/camptribe_dev
PORT=3001

# Brevo SMTP — транзакційні листи: скидання пароля, коди власникам, модерація.
# Домен camptribe.eu автентифіковано в Brevo (DKIM + DMARC), тож окремо
# верифікувати відправника не треба.
# 🔴 SMTP_LOGIN — технічний ідентифікатор для автентифікації. У полі From
# він НЕ використовується ніколи, туди йде MAIL_FROM.
# ⚠️ Ключ згоряє після 90 днів БЕЗ ВИКОРИСТАННЯ, незалежно від дати в Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=
SMTP_KEY=
MAIL_FROM=hello@camptribe.eu
MAIL_FROM_NAME=CampTribe
