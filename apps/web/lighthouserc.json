{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3000",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/camping/si/bled/camping-bled",
        "http://localhost:3000/camping/si/kobarid/spot-n896349092",
        "http://localhost:3000/camping",
        "http://localhost:3000/camping/si",
        "http://localhost:3000/camping/si/bovec"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
